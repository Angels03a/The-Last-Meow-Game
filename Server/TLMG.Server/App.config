<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>
	<connectionStrings configSource="ConnectionStrings.config" />

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="tlmgTcpBinding" maxReceivedMessageSize="65536">
					<readerQuotas maxStringContentLength="8192" maxArrayLength="16384" />
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>

		<behaviors>
			<serviceBehaviors>
				<behavior name="tlmgServiceBehavior">
					<serviceMetadata />
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
		<services>
			<service name="TLMG.Services.ServiceImplementation" behaviorConfiguration="tlmgServiceBehavior">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8081/" />
					</baseAddresses>
				</host>

				<endpoint address="AccountRegistrationService" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.IUsersManager" />
				<endpoint address="LeaderboardManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.ILeaderboardManager" />
				<endpoint address="LobbyManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.ILobbyManager" />
				<endpoint address="FriendsManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.IFriendsManager" />
				<endpoint address="ChatManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.IChatManager" />
				<endpoint address="MatchManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.IMatchManager" />
				<endpoint address="PasswordManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.IPasswordManager" />
				<endpoint address="SessionManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.ISessionManager" />
				<endpoint address="ModerationManager" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.IModerationManager" />
				<endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
			</service>
		</services>
	</system.serviceModel>

</configuration>