<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>
	<connectionStrings>
		<add name="TLMG_DBEntities" 
			 connectionString="metadata=res://*/DatabaseModel.TLMGModel.csdl|res://*/DatabaseModel.TLMGModel.ssdl|res://*/DatabaseModel.TLMGModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost;initial catalog=TLMG_DB;integrated security=True;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" 
			 providerName="System.Data.EntityClient" />
	</connectionStrings>

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="tlmgTcpBinding" maxReceivedMessageSize="65536">
					<readerQuotas maxStringContentLength="8192" maxArrayLength="16384" />
				</binding>
			</netTcpBinding>
		</bindings>
		<behaviors>
			<serviceBehaviors>
				<behavior name="tlmgServiceBehavior">
					<serviceMetadata />
					<serviceDebug includeExceptionDetailInFaults="false" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
		<services>
			<service name="TLMG.Services.ServiceImplementation" behaviorConfiguration="tlmgServiceBehavior">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8081/" />
					</baseAddresses>
				</host>
				<endpoint address="AccountRegistrationService" binding="netTcpBinding"
						  bindingConfiguration="tlmgTcpBinding"
						  contract="TLMG.Contracts.IAccountRegistrationService" />
				<endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
			</service>
		</services>
	</system.serviceModel>

</configuration>