<UserControl x:Class="TLMG.Client.Views.NotificationPresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Opacity="0">
    <Border Background="{DynamicResource Brush_BackgroundPanel}" BorderBrush="{DynamicResource Brush_AccentLight}"
            BorderThickness="2" CornerRadius="10" Padding="20,12" MaxWidth="520">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Notification.Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="20" Foreground="{DynamicResource Brush_White}" Margin="0,0,8,0" />
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource Brush_White}" />
            </StackPanel>
            <TextBlock FontSize="15" Foreground="{DynamicResource Brush_White}" TextWrapping="Wrap">
                <Run Text="{Binding Notification.Subject, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Run x:Name="BodyText" />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
