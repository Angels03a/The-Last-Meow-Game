<local:LocalizableScreen x:Class="TLMG.Client.Views.CreateAccountScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             xmlns:behaviors="clr-namespace:TLMG.Client.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource Brush_BackgroundDark}">
            <Ellipse Style="{StaticResource HeroBackgroundGlowStyle}" />

            <StackPanel Style="{StaticResource HeroContentPanelStyle}">
                <TextBlock Text="🚀" 
                           Style="{StaticResource HeroMainEmojiStyle}" />
                <TextBlock Text="{DynamicResource CreateAccount_HeaderTitle}" 
                           Style="{StaticResource HeroTitleTextStyle}" />
                <TextBlock Text="{DynamicResource CreateAccount_HeaderSubtitle}" 
                           Style="{StaticResource HeroSubtitleSpacedTextStyle}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🐈‍" 
                                   Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Common_EgyptianCatLabel}" 
                                   Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🧟" 
                                   Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Common_ZombieCatLabel}" 
                                   Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="💀" 
                                   Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Common_SkullCatLabel}" 
                                   Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🚀" 
                                   Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Common_AstronautCatLabel}" 
                                   Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource SidePanelBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Style="{StaticResource SidePanelContentStyle}" Margin="20,0">

                    <Button Content="{DynamicResource CreateAccount_BackToLogin}"
                            Style="{StaticResource TopLeftLinkButtonStyle}"
                            Command="{Binding BackCommand}" 
                            Margin="0,20,0,0" />

                    <TextBlock Text="{DynamicResource CreateAccount_Title}"
                               Style="{StaticResource FormTitleTextStyle}" />

                    <TextBlock Text="{DynamicResource CreateAccount_NicknameLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}" />
                    <TextBlock Text="{DynamicResource CreateAccount_NicknameHint}" 
                               Style="{StaticResource FieldHintTextStyle}" />
                    <TextBlock Text="{Binding NicknameErrorMessage}"
                               Visibility="{Binding HasNicknameError, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource ErrorTextStyle}" 
                               TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource CreateAccount_EmailLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}" />
                    <TextBlock Text="{Binding EmailErrorMessage}"
                               Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource ErrorTextStyle}" 
                               TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource CreateAccount_PasswordLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <PasswordBox Style="{StaticResource FieldStyle}"
                                 Margin="0,0,0,10"
                                 behaviors:PasswordBindingBehavior.BindPassword="True"
                                 behaviors:PasswordBindingBehavior.BoundPassword="{Binding Password}" />
                    <TextBlock Text="{Binding PasswordErrorMessage}"
                               Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource ErrorTextStyle}" 
                               TextWrapping="Wrap" />

                    <Border Style="{StaticResource SpacedHintPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CreateAccount_HintLength}" 
                                       Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintUppercase}" 
                                       Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintLowercase}" 
                                       Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintNumber}" 
                                       Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintSymbol}" 
                                       Style="{StaticResource StatusTextStyle}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource CreateAccount_ConfirmPasswordLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" 
                               Height="15" />
                    <PasswordBox Style="{StaticResource FieldStyle}"
                                 behaviors:PasswordBindingBehavior.BindPassword="True"
                                 behaviors:PasswordBindingBehavior.BoundPassword="{Binding ConfirmPassword}" />
                    <TextBlock Text="{Binding ConfirmPasswordErrorMessage}"
                               Visibility="{Binding HasConfirmPasswordError, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource ErrorTextStyle}" 
                               TextWrapping="Wrap" />

                    <CheckBox IsChecked="{Binding HasAcceptedTerms, UpdateSourceTrigger=PropertyChanged}" 
                              Style="{StaticResource TermsCheckBoxStyle}">
                        <TextBlock Text="{DynamicResource CreateAccount_TermsLabel}"
                                   Style="{StaticResource TermsTextStyle}"
                                   TextWrapping="Wrap" />
                    </CheckBox>

                    <Button Content="{DynamicResource CreateAccount_CreateAccountButton}"
                            Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                            Command="{Binding CreateAccountCommand}" />

                    <TextBlock Text="{Binding FormErrorMessage}"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource FormMessageTextStyle}"
                               TextWrapping="Wrap" 
                               TextAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</local:LocalizableScreen>