<local:LocalizableScreen x:Class="TLMG.Client.Views.ChangePasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             xmlns:behaviors="clr-namespace:TLMG.Client.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource LeaderboardSidebarBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource ChangePassword_SidebarTitle}"
                           Style="{StaticResource SidebarTitleTextStyle}" />

                <Button Grid.Row="2"
                        Content="{DynamicResource ChangePassword_BackToProfileButton}"
                        Style="{StaticResource SidebarBackButtonStyle}"
                        Width="Auto"
                        Padding="16,0"
                        Command="{Binding BackCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="700"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40,48">

                <TextBlock Text="{DynamicResource ChangePassword_Title}"
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="28"
                           Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource ChangePassword_Subtitle}"
                           Style="{StaticResource SubtitleLargeTextStyle}"
                           Margin="0,0,0,28" />

                <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,20" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="56"
                                Height="56"
                                CornerRadius="28"
                                Background="{StaticResource Brush_AccentSoft}"
                                BorderBrush="{StaticResource Brush_Border}"
                                BorderThickness="1"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AvatarEmoji}"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nickname}"
                                       Style="{StaticResource FriendNameTextStyle}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Email}"
                                       Style="{StaticResource SubtitleTextStyle}"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusIndicatorDotStyle}" />
                                <TextBlock Text="{DynamicResource ChangePassword_VerifiedAccountStatus}"
                                           Style="{StaticResource StatusIndicatorTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource OptionsCardStyle}" Margin="0" Padding="28">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ChangePassword_CurrentPasswordLabel}"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Margin="0,0,0,6" />
                        <PasswordBox Style="{StaticResource FieldStyle}"
                                     behaviors:PasswordBindingBehavior.BindPassword="True"
                                     behaviors:PasswordBindingBehavior.BoundPassword="{Binding CurrentPassword}" />
                        <TextBlock Text="{Binding CurrentPasswordErrorMessage}"
                                   Visibility="{Binding HasCurrentPasswordError, Converter={StaticResource BoolToVis}}"
                                   Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Text="{DynamicResource ChangePassword_NewPasswordLabel}"
                                   Style="{StaticResource FieldLabelTextStyle}" />
                        <PasswordBox Style="{StaticResource FieldStyle}"
                                     behaviors:PasswordBindingBehavior.BindPassword="True"
                                     behaviors:PasswordBindingBehavior.BoundPassword="{Binding NewPassword}" />
                        <TextBlock Text="{Binding NewPasswordErrorMessage}"
                                   Visibility="{Binding HasNewPasswordError, Converter={StaticResource BoolToVis}}"
                                   Style="{StaticResource ErrorTextStyle}" />

                        <Border Style="{StaticResource HintPanelStyle}" Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ChangePassword_RequirementsHeader}"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource ChangePassword_HintLength}"
                                           Style="{StaticResource StatusTextStyle}"
                                           Margin="0,2" />
                                <TextBlock Text="{DynamicResource ChangePassword_HintUppercase}"
                                           Style="{StaticResource StatusTextStyle}"
                                           Margin="0,2" />
                                <TextBlock Text="{DynamicResource ChangePassword_HintLowercase}"
                                           Style="{StaticResource StatusTextStyle}"
                                           Margin="0,2" />
                                <TextBlock Text="{DynamicResource ChangePassword_HintNumber}"
                                           Style="{StaticResource StatusTextStyle}"
                                           Margin="0,2" />
                                <TextBlock Text="{DynamicResource ChangePassword_HintSymbol}"
                                           Style="{StaticResource StatusTextStyle}"
                                           Margin="0,2" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource ChangePassword_ConfirmPasswordLabel}"
                                   Style="{StaticResource FieldLabelTextStyle}" />
                        <PasswordBox Style="{StaticResource FieldStyle}"
                                     behaviors:PasswordBindingBehavior.BindPassword="True"
                                     behaviors:PasswordBindingBehavior.BoundPassword="{Binding ConfirmNewPassword}" />
                        <TextBlock Text="{Binding ConfirmNewPasswordErrorMessage}"
                                   Visibility="{Binding HasConfirmNewPasswordError, Converter={StaticResource BoolToVis}}"
                                   Style="{StaticResource ErrorTextStyle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="{DynamicResource ChangePassword_UpdateButton}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="24,0"
                                    Margin="0,0,12,0"
                                    Command="{Binding UpdatePasswordCommand}" />
                            <Button Content="{DynamicResource ChangePassword_CancelButton}"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    MinWidth="110"
                                    Padding="20,0"
                                    Command="{Binding CancelCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding FormMessage}"
                                   Visibility="{Binding HasFormMessage, Converter={StaticResource BoolToVis}}"
                                   Style="{StaticResource FormMessageTextStyle}"
                                   HorizontalAlignment="Left"
                                   TextAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:LocalizableScreen>