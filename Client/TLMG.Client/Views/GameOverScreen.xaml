<local:LocalizableScreen x:Class="TLMG.Client.Views.GameOverScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDeep}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource GameOver_HeaderLabel}"
                           Style="{StaticResource GameOverHeaderTextStyle}" />

                <Grid Style="{StaticResource GameOverWinnerGridStyle}">
                    <Ellipse Style="{StaticResource HeroBackgroundGlowStyle}" />
                    <Border Style="{StaticResource GameOverWinnerAvatarBorderStyle}">
                        <TextBlock Text="🐯" 
                                   Style="{StaticResource GameOverWinnerEmojiStyle}" />
                    </Border>
                </Grid>

                <TextBlock x:Name="lblWinnerTitle" 
                           Style="{StaticResource GameOverTitleTextStyle}" />

                <TextBlock Text="{DynamicResource GameOver_StandingsUnavailable}"
                           >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource GameOverStandingsTitleTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStandings}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding StandingEntries}" Margin="0,12,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GameOverRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}" Style="{StaticResource GameOverRankTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               Style="{StaticResource GameOverPlayerNameTextStyle}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Points}" Style="{StaticResource GameOverWinsValueTextStyle}" />
                                        <TextBlock Text="{DynamicResource GameOver_PointsLabel}"
                                                   Style="{StaticResource GameOverWinsLabelTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Style="{StaticResource ResultActionsPanelStyle}">
                    <Button x:Name="btnMainMenu"
                            Content="{DynamicResource GameOver_MainMenuButton}"
                            Style="{StaticResource ResultSecondaryButtonStyle}"
                            Command="{Binding MainMenuCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <local:NotificationPresenter HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,30,12,0"
                                     Notification="{Binding Notification}" />
    </Grid>
</local:LocalizableScreen>