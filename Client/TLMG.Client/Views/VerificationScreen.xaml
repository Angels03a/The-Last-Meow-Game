<local:LocalizableScreen x:Class="TLMG.Client.Views.VerificationScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>
    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}" Width="680">
            <StackPanel>
                <Border Style="{StaticResource VerificationHeaderIconBorderStyle}">
                    <TextBlock Text="✉" Style="{StaticResource HeaderEmojiStyle}" />
                </Border>

                <TextBlock Text="{DynamicResource Verification_Title}"
                           Style="{StaticResource CenteredTitleMediumTextStyle}" />

                <TextBlock Text="{DynamicResource Verification_Instructions}"
                           Style="{StaticResource CenteredSubtitleTextStyle}" />

                <StackPanel Style="{StaticResource VerificationDigitsContainerStyle}">
                    <TextBox x:Name="txtDigit1"
                             Style="{StaticResource VerificationDigitStyle}"
                             Text="{Binding Digit1, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding AreDigitsEnabled}"
                             TextChanged="DigitBox_TextChanged"
                             PreviewKeyDown="DigitBox_PreviewKeyDown" />
                    <TextBox x:Name="txtDigit2"
                             Style="{StaticResource VerificationDigitStyle}"
                             Text="{Binding Digit2, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding AreDigitsEnabled}"
                             TextChanged="DigitBox_TextChanged"
                             PreviewKeyDown="DigitBox_PreviewKeyDown" />
                    <TextBox x:Name="txtDigit3"
                             Style="{StaticResource VerificationDigitStyle}"
                             Text="{Binding Digit3, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding AreDigitsEnabled}"
                             TextChanged="DigitBox_TextChanged"
                             PreviewKeyDown="DigitBox_PreviewKeyDown" />
                    <TextBox x:Name="txtDigit4"
                             Style="{StaticResource VerificationDigitStyle}"
                             Text="{Binding Digit4, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding AreDigitsEnabled}"
                             TextChanged="DigitBox_TextChanged"
                             PreviewKeyDown="DigitBox_PreviewKeyDown" />
                    <TextBox x:Name="txtDigit5"
                             Style="{StaticResource VerificationDigitStyle}"
                             Text="{Binding Digit5, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding AreDigitsEnabled}"
                             TextChanged="DigitBox_TextChanged"
                             PreviewKeyDown="DigitBox_PreviewKeyDown" />
                    <TextBox x:Name="txtDigit6"
                             Style="{StaticResource VerificationDigitStyle}"
                             Text="{Binding Digit6, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding AreDigitsEnabled}"
                             TextChanged="DigitBox_TextChanged"
                             PreviewKeyDown="DigitBox_PreviewKeyDown" />
                </StackPanel>

                <StackPanel Style="{StaticResource AttemptDotsContainerStyle}">
                    <Ellipse x:Name="ellAttempt1"
                             Style="{StaticResource AttemptDotStyle}" />
                    <Ellipse x:Name="ellAttempt2"
                             Style="{StaticResource AttemptDotStyle}" />
                    <Ellipse x:Name="ellAttempt3"
                             Style="{StaticResource AttemptDotStyle}" />
                </StackPanel>

                <StackPanel Style="{StaticResource ExpirationContainerStyle}">
                    <TextBlock Text="{DynamicResource Verification_ExpiresIn}"
                               Style="{StaticResource FieldLabelTextStyle}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ExpirationText}"
                               Style="{StaticResource VerificationExpirationTextStyle}" />
                </StackPanel>

                <Button x:Name="btnResendCode"
                        Content="{DynamicResource Verification_ResendCodeButton}"
                        Style="{StaticResource VerificationResendButtonStyle}"
                        Command="{Binding ResendCodeCommand}" />

                <Button Content="{DynamicResource Verification_VerifyCodeButton}"
                        Style="{StaticResource VerificationPrimaryButtonStyle}"
                        Command="{Binding VerifyCodeCommand}" />

                <Border Style="{StaticResource VerificationBackContainerStyle}">
                    <Button Content="{DynamicResource Verification_BackButton}"
                            Style="{StaticResource CenteredLinkButtonStyle}"
                            Command="{Binding BackCommand}" />
                </Border>

                <TextBlock x:Name="lblVerificationError"
                           Style="{StaticResource VerificationErrorTextStyle}" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</local:LocalizableScreen>