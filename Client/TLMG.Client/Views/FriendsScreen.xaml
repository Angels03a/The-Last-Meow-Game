<local:LocalizableScreen x:Class="TLMG.Client.Views.FriendsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SidePanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="{DynamicResource Friends_SidebarTitle}" 
                           Style="{StaticResource SidebarTitleTextStyle}" />

                <Button Grid.Row="2" 
                        Content="{DynamicResource Common_BackButton}"
                        Style="{StaticResource SidebarBackButtonStyle}"
                        Command="{Binding BackCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="40,32,40,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" 
                         Grid.Column="0" 
                         Style="{StaticResource SearchFieldStyle}" 
                         Tag="{DynamicResource Friends_SearchPlaceholder}"
                         Visibility="Collapsed" />

                <Button x:Name="btnAddFriend" 
                        Grid.Column="2" 
                        Content="{DynamicResource Friends_AddFriendButton}" 
                        Style="{StaticResource AddFriendButtonStyle}"
                        Visibility="Collapsed" />

                <TextBlock x:Name="lblFriendsStatusMessage"
                           Grid.Column="0"
                           Style="{StaticResource FormMessageTextStyle}"
                           Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,0,0,1" Margin="40,0,40,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnTabFriends" 
                            Style="{StaticResource TabNavActiveButtonStyle}" 
                            Click="BtnTab_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabFriends}" 
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgeFriends" Style="{StaticResource BadgeActiveStyle}">
                                <TextBlock Text="{Binding FriendsBadgeCount}" 
                                           Style="{StaticResource BadgeTextActiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnTabPending" Style="{StaticResource TabNavInactiveButtonStyle}" Click="BtnTab_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabPending}" 
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgePending" Style="{StaticResource BadgeInactiveStyle}">
                                <TextBlock x:Name="lblBadgePending" 
                                           Text="2" 
                                           Style="{StaticResource BadgeTextInactiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnTabBlocked" Style="{StaticResource TabNavInactiveButtonStyle}" Click="BtnTab_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabBlocked}" 
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgeBlocked" Style="{StaticResource BadgeInactiveStyle}">
                                <TextBlock x:Name="lblBadgeBlocked" 
                                           Text="1" 
                                           Style="{StaticResource BadgeTextInactiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="40,24,40,24">
                <Grid>
                    <StackPanel x:Name="pnlFriendsContent" Visibility="Visible">
                        <ItemsControl ItemsSource="{Binding FriendsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FriendCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                                <Border Style="{StaticResource FriendAvatarBorderStyle}">
                                                    <TextBlock Text="🐱" Style="{StaticResource FriendAvatarEmojiStyle}" />
                                                </Border>
                                                <Ellipse x:Name="ellFriendStatus" Style="{StaticResource StatusDotOfflineStyle}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nickname}" Style="{StaticResource FriendNameTextStyle}" />
                                                <TextBlock x:Name="lblFriendStatus" Text="{DynamicResource Friends_StatusOffline}" Style="{StaticResource StatusTextOfflineStyle}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="btnInviteFriend"
                                                        Content="{DynamicResource Friends_InviteButton}"
                                                        Style="{StaticResource ActionPrimarySmallButtonStyle}"
                                                        IsEnabled="{Binding CanBeInvited}"
                                                        Click="BtnInviteFriend_Click" />
                                                <Button Content="{DynamicResource Friends_BlockButton}"
                                                        Style="{StaticResource ActionDangerOutlineButtonStyle}"
                                                        Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter TargetName="ellFriendStatus" Property="Style" Value="{StaticResource StatusDotOnlineStyle}" />
                                            <Setter TargetName="lblFriendStatus" Property="Text" Value="{DynamicResource Friends_StatusOnline}" />
                                            <Setter TargetName="lblFriendStatus" Property="Style" Value="{StaticResource StatusTextOnlineStyle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanBeInvited}" Value="False">
                                            <Setter TargetName="btnInviteFriend" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource {Binding EmptyFriendsMessageKey}}" 
                               Style="{StaticResource EmptyStateTextStyle}" 
                               Visibility="{Binding IsEmptyFriendsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel x:Name="pnlPendingContent" Visibility="Collapsed">
                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0">
                                    <TextBlock Text="🚀" Style="{StaticResource FriendAvatarEmojiStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="AstroKitty" Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_PendingIncoming}" Style="{StaticResource StatusTextOfflineStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_AcceptButton}" Style="{StaticResource ActionSuccessButtonStyle}" />
                                    <Button Content="{DynamicResource Friends_DeclineButton}" Style="{StaticResource ActionDangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0">
                                    <TextBlock Text="🐱" Style="{StaticResource FriendAvatarEmojiStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SchroBinger" Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_PendingOutgoing}" Style="{StaticResource StatusTextOfflineStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_CancelButton}" Style="{StaticResource ActionGhostSmallButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="lblEmptyPending" 
                               Text="{DynamicResource Friends_EmptyPending}" 
                               Style="{StaticResource EmptyStateTextStyle}" 
                               Visibility="Collapsed" />

                    <StackPanel x:Name="pnlBlockedContent" Visibility="Collapsed">
                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0" Background="{StaticResource Brush_BackgroundDark}">
                                    <TextBlock Text="🐱" Style="{StaticResource FriendAvatarEmojiStyle}" Opacity="0.5" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ToxicTabby" Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_BlockedReason}" Style="{StaticResource StatusTextDangerStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_UnblockButton}" Style="{StaticResource ActionGhostSmallButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="lblEmptyBlocked" 
                               Text="{DynamicResource Friends_EmptyBlocked}" 
                               Style="{StaticResource EmptyStateTextStyle}" 
                               Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:LocalizableScreen>