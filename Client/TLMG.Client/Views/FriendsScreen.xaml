<local:LocalizableScreen x:Class="TLMG.Client.Views.FriendsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             xmlns:behaviors="clr-namespace:TLMG.Client.Behaviors"
             mc:Ignorable="d"
             behaviors:WaitCursorBehavior.IsBusy="{Binding IsBusy}"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SidePanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Friends_SidebarTitle}"
                           Style="{StaticResource SidebarTitleTextStyle}" />

                <Button Grid.Row="2"
                        Content="{DynamicResource Common_BackButton}"
                        Style="{StaticResource SidebarBackButtonStyle}"
                        Command="{Binding BackCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="40,32,40,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0"
                         Grid.Column="0"
                         Style="{StaticResource SearchFieldStyle}"
                         Tag="{DynamicResource Friends_SearchPlaceholder}"
                         Text="{Binding NewFriendNickname, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="20"
                         Visibility="{Binding IsRegisteredPlayer, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddFriendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="{DynamicResource Friends_AddFriendButton}"
                        Style="{StaticResource AddFriendButtonStyle}"
                        Command="{Binding AddFriendCommand}"
                        Visibility="{Binding IsRegisteredPlayer, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           DataContext="{Binding FriendsMessage}"
                           Text="{Binding Text}"
                           Style="{StaticResource StatusMessageTextStyle}" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,0,0,1" Margin="40,0,40,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnTabFriends"
                            Style="{StaticResource TabNavActiveButtonStyle}"
                            Click="BtnTab_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabFriends}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgeFriends" Style="{StaticResource BadgeActiveStyle}">
                                <TextBlock Text="{Binding FriendsBadgeCount}"
                                           Style="{StaticResource BadgeTextActiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnTabPending"
                            Style="{StaticResource TabNavInactiveButtonStyle}"
                            Click="BtnTab_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabPending}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgePending" Style="{StaticResource BadgeInactiveStyle}">
                                <TextBlock Text="{Binding PendingBadgeCount}"
                                           Style="{StaticResource BadgeTextInactiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnTabBlocked"
                            Style="{StaticResource TabNavInactiveButtonStyle}"
                            Visibility="{Binding IsRegisteredPlayer, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="BtnTab_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabBlocked}" VerticalAlignment="Center" />
                            <Border x:Name="brdBadgeBlocked" Style="{StaticResource BadgeInactiveStyle}"
                                    Visibility="{Binding BlockedPlayers.HasLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding BlockedPlayers.Players.Count}"
                                           Style="{StaticResource BadgeTextInactiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="40,24,40,24">
                <Grid>
                    <StackPanel x:Name="pnlFriendsContent" Visibility="Visible">
                        <ItemsControl ItemsSource="{Binding FriendsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FriendCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                                <Border Style="{StaticResource FriendAvatarBorderStyle}">
                                                    <TextBlock Text="🐱" Style="{StaticResource FriendAvatarEmojiStyle}" />
                                                </Border>
                                                <Ellipse x:Name="ellFriendStatus" Style="{StaticResource StatusDotOfflineStyle}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nickname}" Style="{StaticResource FriendNameTextStyle}" />
                                                <TextBlock x:Name="lblFriendStatus" Text="{DynamicResource Friends_StatusOffline}" Style="{StaticResource StatusTextOfflineStyle}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="btnInviteFriend"
                                                        Content="{DynamicResource Friends_InviteButton}"
                                                        Style="{StaticResource ActionPrimarySmallButtonStyle}"
                                                        Command="{Binding DataContext.InviteFriendCommand, RelativeSource={RelativeSource AncestorType=local:FriendsScreen}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter TargetName="ellFriendStatus" Property="Style" Value="{StaticResource StatusDotOnlineStyle}" />
                                            <Setter TargetName="lblFriendStatus" Property="Text" Value="{DynamicResource Friends_StatusOnline}" />
                                            <Setter TargetName="lblFriendStatus" Property="Style" Value="{StaticResource StatusTextOnlineStyle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanBeInvited}" Value="False">
                                            <Setter TargetName="btnInviteFriend" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Visibility="{Binding IsEmptyFriendsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                                    <Setter Property="Text" Value="{DynamicResource Friends_EmptyFriends}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGuest}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Friends_GuestWithoutFriendsMessage}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel x:Name="pnlPendingContent" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding PendingRequests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FriendCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0">
                                                <TextBlock Text="🐱" Style="{StaticResource FriendAvatarEmojiStyle}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nickname}" Style="{StaticResource FriendNameTextStyle}" />
                                                <TextBlock x:Name="lblRequestDirection" Text="{DynamicResource Friends_PendingOutgoing}" Style="{StaticResource StatusTextOfflineStyle}" />
                                            </StackPanel>

                                            <StackPanel x:Name="pnlRequestActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Button Content="{DynamicResource Friends_AcceptButton}"
                                                        Style="{StaticResource ActionSuccessButtonStyle}"
                                                        Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=local:FriendsScreen}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{DynamicResource Friends_DeclineButton}"
                                                        Style="{StaticResource ActionDangerButtonStyle}"
                                                        Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=local:FriendsScreen}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                                            <Setter TargetName="lblRequestDirection" Property="Text" Value="{DynamicResource Friends_PendingIncoming}" />
                                            <Setter TargetName="pnlRequestActions" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{DynamicResource Friends_EmptyPending}"
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   Visibility="{Binding IsEmptyPendingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel x:Name="pnlBlockedContent" Visibility="Collapsed" DataContext="{Binding BlockedPlayers}">
                        <Button Content="{DynamicResource Friends_RefreshBlockedButton}"
                                Style="{StaticResource ActionPrimarySmallButtonStyle}"
                                HorizontalAlignment="Right"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding CanInteract}" />
                        <TextBlock Text="{DynamicResource Friends_BlockedLoading}"
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{DynamicResource Friends_BlockedLookupFailed}"
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   Visibility="{Binding HasLookupFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Players}" IsEnabled="{Binding CanInteract}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FriendCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0">
                                                <TextBlock Text="🐱" Style="{StaticResource FriendAvatarEmojiStyle}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Nickname}"
                                                       VerticalAlignment="Center" Style="{StaticResource FriendNameTextStyle}" />
                                            <Button Grid.Column="2" Content="{DynamicResource Friends_UnblockButton}"
                                                    Style="{StaticResource ActionPrimarySmallButtonStyle}"
                                                    Command="{Binding DataContext.BlockedPlayers.UnblockCommand, RelativeSource={RelativeSource AncestorType=local:FriendsScreen}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource Friends_EmptyBlocked}"
                                   Style="{StaticResource EmptyStateTextStyle}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:LocalizableScreen>