<local:LocalizableScreen x:Class="TLMG.Client.Views.ForgotPasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             xmlns:behaviors="clr-namespace:TLMG.Client.Behaviors"
             mc:Ignorable="d"
             behaviors:WaitCursorBehavior.IsBusy="{Binding IsBusy}"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}" Width="680">
            <StackPanel>
                <StackPanel Style="{StaticResource StepTrackerContainerStyle}">
                    <Border Style="{StaticResource StepCircleActiveStyle}">
                        <TextBlock Text="1" Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Common_StepEmail}" Style="{StaticResource StepLabelActiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleInactiveStyle}">
                        <TextBlock Text="2" Style="{StaticResource StepNumberInactiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Common_StepVerify}" Style="{StaticResource StepLabelInactiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleInactiveStyle}">
                        <TextBlock Text="3" Style="{StaticResource StepNumberInactiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Common_StepNewPassword}" Style="{StaticResource StepLabelInactiveStyle}" Margin="8,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource HeaderIconBorderStyle}">
                    <TextBlock Text="🔒" Style="{StaticResource HeaderEmojiStyle}" />
                </Border>

                <TextBlock Text="{DynamicResource ForgotPassword_Title}"
                           Style="{StaticResource CenteredTitleMediumTextStyle}" />

                <TextBlock Text="{DynamicResource ForgotPassword_Instructions}"
                           Style="{StaticResource CenteredSubtitleTextStyle}" />

                <TextBlock Text="{DynamicResource ForgotPassword_EmailLabel}"
                           Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,6" />

                <StackPanel Margin="0,0,0,16">
                    <TextBox x:Name="txtEmail"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:TextInputBehavior.InputType="Email"
                             Style="{StaticResource FieldStyle}"
                             LostFocus="TxtEmail_LostFocus" />
                    <TextBlock DataContext="{Binding EmailError}"
                               Text="{Binding Text}"
                               Style="{StaticResource StatusMessageTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Content="{DynamicResource ForgotPassword_SendCodeButton}"
                        Style="{StaticResource BottomActionPrimaryButtonStyle}"
                        Command="{Binding SendCodeCommand}" />

                <Button Content="{DynamicResource ForgotPassword_BackToLoginButton}"
                        Style="{StaticResource CenteredLinkButtonStyle}"
                        Command="{Binding BackCommand}" />

                <TextBlock DataContext="{Binding FormMessage}"
                           Text="{Binding Text}"
                           Style="{StaticResource StatusMessageTextStyle}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</local:LocalizableScreen>