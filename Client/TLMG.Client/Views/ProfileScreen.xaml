<local:LocalizableScreen x:Class="TLMG.Client.Views.ProfileScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             xmlns:models="clr-namespace:TLMG.Client.Models"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SidePanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Profile_SidebarTitle}"
                           Style="{StaticResource SidebarTitleTextStyle}" />

                <Button Grid.Row="2"
                        Content="{DynamicResource Common_BackButton}"
                        Style="{StaticResource SidebarBackButtonStyle}"
                        Command="{Binding BackCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="64,48,64,48" MaxWidth="1000" HorizontalAlignment="Left">

                <TextBlock Text="{DynamicResource Profile_MainTitle}"
                           Style="{StaticResource OptionsMainTitleStyle}" />

                <Border Style="{StaticResource OptionsCardStyle}" Padding="32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="100" Height="100" Margin="0,0,32,0">
                            <Border Style="{StaticResource ProfileAvatarCircleStyle}">
                                <TextBlock Text="{Binding CurrentAvatar}"
                                           Style="{StaticResource HeroMainEmojiStyle}"
                                           FontSize="64"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush_TextPrimary}" />
                            </Border>
                            <Button Style="{StaticResource EditPencilButtonStyle}"
                                    Command="{Binding ToggleAvatarEditModeCommand}"
                                    Panel.ZIndex="1">
                                <TextBlock Text="✎"
                                           FontSize="18"
                                           Foreground="{StaticResource Brush_Gold}"
                                           Margin="1,-2,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayNickname}"
                                       Style="{StaticResource TitleMediumTextStyle}"
                                       Margin="0,0,0,16" />

                            <Grid Style="{StaticResource ProfileStatsVisibilityStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                    <TextBlock Text="142"
                                               Style="{StaticResource ProfileStatValueStyle}"
                                               Foreground="{StaticResource Brush_AccentLight}" />
                                    <TextBlock Text="{DynamicResource Common_Wins}"
                                               Style="{StaticResource StatCardLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,32,0">
                                    <TextBlock Text="1,840"
                                               Style="{StaticResource ProfileStatValueStyle}"
                                               Foreground="{StaticResource Brush_LilacLight}" />
                                    <TextBlock Text="{DynamicResource Profile_Rating}"
                                               Style="{StaticResource StatCardLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,32,0">
                                    <TextBlock Text="#38"
                                               Style="{StaticResource ProfileStatValueStyle}"
                                               Foreground="{StaticResource Brush_Gold}" />
                                    <TextBlock Text="{DynamicResource Common_Rank}"
                                               Style="{StaticResource StatCardLabelStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="87%"
                                               Style="{StaticResource ProfileStatValueStyle}"
                                               Foreground="{StaticResource Brush_LilacLight}" />
                                    <TextBlock Text="{DynamicResource Profile_WinRate}"
                                               Style="{StaticResource StatCardLabelStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Style="{StaticResource ProfileAvatarSelectionVisibilityStyle}">
                                <TextBlock Text="{DynamicResource Profile_ChooseAvatar}"
                                           Style="{StaticResource StatCardLabelStyle}"
                                           Margin="0,0,0,12" />
                                <WrapPanel>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.DefaultAvatarKey}">
                                        <TextBlock Text="🐱" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.ZombieAvatarKey}">
                                        <TextBlock Text="🧟" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.SkullAvatarKey}">
                                        <TextBlock Text="💀" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.RocketAvatarKey}">
                                        <TextBlock Text="🚀" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.TigerAvatarKey}">
                                        <TextBlock Text="🐯" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.LionAvatarKey}">
                                        <TextBlock Text="🦁" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.FrogAvatarKey}">
                                        <TextBlock Text="🐸" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarSelectionButtonStyle}"
                                            Command="{Binding SelectAvatarCommand}"
                                            CommandParameter="{x:Static models:AvatarCatalog.AlienAvatarKey}">
                                        <TextBlock Text="👾" FontSize="32" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush_TextPrimary}" />
                                    </Button>
                                    <Button Style="{StaticResource AvatarUploadButtonStyle}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="📷"
                                                       FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource Brush_TextPrimary}" />
                                            <TextBlock Text="{DynamicResource Profile_UploadAvatar}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource Brush_TextFaint}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource OptionsCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Profile_NicknameTitle}"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayNickname}"
                                           Style="{StaticResource ProfileReadNicknameTextStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{DynamicResource Profile_EditNicknameButton}"
                                        Style="{StaticResource ProfileReadNicknameButtonStyle}"
                                        Command="{Binding BeginNicknameEditCommand}" />

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource ProfileEditNicknameTextBoxStyle}"
                                         Text="{Binding EditingNickname, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,16,0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource ProfileSaveNicknameButtonStyle}"
                                        Command="{Binding SaveNicknameCommand}">
                                    <TextBlock Text="✓" FontSize="16" FontWeight="Bold" />
                                </Button>
                            </Grid>

                            <TextBlock Text="{DynamicResource Profile_NicknameHint}"
                                       Style="{StaticResource ProfileNicknameHintTextStyle}"
                                       Margin="0,8,0,0" />

                            <TextBlock DataContext="{Binding NicknameError}"
                                       Text="{Binding Text}"
                                       Style="{StaticResource StatusMessageTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource OptionsCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Profile_EmailTitle}"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,16" />
                            <TextBlock Text="{Binding Email}"
                                       Style="{StaticResource SidebarProfileUsernameStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource Profile_EmailVerified}"
                                       Style="{StaticResource VerifiedTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource OptionsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Profile_SecurityTitle}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,16" />
                        <TextBlock Text="{Binding LastPasswordChangeLabel}"
                                   Style="{StaticResource StatusTextStyle}"
                                   Margin="0,0,0,16" />
                        <Button Content="{DynamicResource Profile_ChangePasswordButton}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Width="180"
                                HorizontalAlignment="Left"
                                Command="{Binding ChangePasswordCommand}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:LocalizableScreen>