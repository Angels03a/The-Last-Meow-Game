<local:LocalizableScreen x:Class="TLMG.Client.Views.LobbyScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">

        <Grid x:Name="grdKickModal" Visibility="Collapsed" Background="#D8000000" Panel.ZIndex="100">
            <Border Style="{StaticResource ModalBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🗳️"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"
                               FontFamily="Segoe UI Emoji"
                               Foreground="{StaticResource Brush_TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Lobby_KickModalTitle}"
                               Style="{StaticResource TitleMediumTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource Lobby_KickModalDescription}"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnCancelKick"
                                Grid.Column="0"
                                Content="{DynamicResource Lobby_CancelKickButton}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Click="BtnCancelKick_Click" />
                        <Button x:Name="btnConfirmKick"
                                Grid.Column="2"
                                Content="{DynamicResource Lobby_ConfirmKickButton}"
                                Style="{StaticResource ActionDangerButtonStyle}"
                                Height="42"
                                Click="BtnConfirmKick_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="brdToast" Visibility="Collapsed" Style="{StaticResource ToastBorderStyle}" Panel.ZIndex="101">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📄"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Emoji"
                           Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock Text="{DynamicResource Lobby_KickToastMessage}"
                           Style="{StaticResource StatusTextOnlineStyle}"
                           Foreground="{StaticResource Brush_White}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid x:Name="grdCountdown"
              Visibility="{Binding IsCountdownVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#E60D0D12"
              Panel.ZIndex="90">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Lobby_CountdownTitle}"
                           Style="{StaticResource TitleMediumTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           Foreground="{StaticResource Brush_Gold}"/>
                <TextBlock Text="{Binding CountdownSecondsRemaining}"
                           FontSize="120"
                           FontWeight="Black"
                           Foreground="{StaticResource Brush_White}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,48"
                           Visibility="{Binding HasCountdownSeconds, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{DynamicResource Lobby_CountdownWaitingLabel}"
                           FontSize="32"
                           FontWeight="Black"
                           Foreground="{StaticResource Brush_White}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,48">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCountdownSeconds}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="{DynamicResource Lobby_CancelCountdown}"
                        Style="{StaticResource ActionDangerOutlineButtonStyle}"
                        Width="200"
                        Height="48"
                        FontSize="16"
                        Command="{Binding CancelCountdownCommand}" />
            </StackPanel>
        </Grid>

        <Popup x:Name="popPlayerOptions"
               StaysOpen="False"
               Placement="MousePoint"
               AllowsTransparency="True">
            <Border Style="{StaticResource ContextMenuBorderStyle}">
                <StackPanel>
                    <TextBlock Text="NYANPROWLER"
                               Style="{StaticResource ContextMenuHeaderStyle}" />
                    <Button x:Name="btnMenuKick"
                            Content="{DynamicResource Lobby_ConfirmKickButton}"
                            Style="{StaticResource ContextMenuItemStyle}"
                            Click="BtnMenuKick_Click" />
                    <Button Content="{DynamicResource Lobby_MenuReport}"
                            Style="{StaticResource ContextMenuItemStyle}" />
                    <Button Content="{DynamicResource Lobby_MenuBlock}"
                            Style="{StaticResource ContextMenuDangerItemStyle}" />
                    <Button Content="{DynamicResource Lobby_CancelKickButton}"
                            Style="{StaticResource ContextMenuItemStyle}"
                            Click="BtnMenuCancel_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SidePanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,24,32">
                        <Grid Margin="0,0,0,24" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}">
                                <TextBlock Text="🐱"
                                           Style="{StaticResource FriendAvatarEmojiStyle}"
                                           FontFamily="Segoe UI Emoji" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource FriendNameTextStyle}" />
                                <TextBlock Text="{DynamicResource Lobby_RoomCreator}"
                                           Style="{StaticResource StatusTextOfflineStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,32" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text=""
                                           Style="{StaticResource ProfileStatValueStyle}"
                                           Foreground="{StaticResource Brush_Gold}"/>
                                <TextBlock Text="{DynamicResource Common_Wins}"
                                           Style="{StaticResource StatCardLabelStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text=""
                                           Style="{StaticResource ProfileStatValueStyle}"
                                           Foreground="{StaticResource Brush_LilacLight}"/>
                                <TextBlock Text="{DynamicResource Common_Rank}"
                                           Style="{StaticResource StatCardLabelStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="{DynamicResource Lobby_InviteFriends}"
                                Style="{StaticResource ActionGhostSmallButtonStyle}"
                                Margin="0,0,0,16"
                                Command="{Binding InviteFriendsCommand}" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="{DynamicResource Lobby_LeaveLobby}"
                            Style="{StaticResource ActionDangerButtonStyle}"
                            Height="48"
                            Margin="24,24,24,32"
                            Command="{Binding LeaveLobbyCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="grdMainCenter">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="40,32,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Lobby_MainTitle}"
                                   Style="{StaticResource TitleMediumTextStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RoomInformation}"
                                   Style="{StaticResource SubtitleTextStyle}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource LobbyToggleReadyButtonStyle}"
                            MinWidth="160" Height="48"
                            Margin="16,0,0,0"
                            Command="{Binding ToggleReadyCommand}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasRoom, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Lobby_CardsPerPlayer}"
                                   Style="{StaticResource StatCardLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <ComboBox x:Name="cmbGameMode"
                                  Width="280"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  SelectedIndex="{Binding SelectedCardsPerPlayerIndex}"
                                  IsEnabled="{Binding IsReadyButtonEnabled}">
                            <ComboBoxItem Content="{DynamicResource Lobby_GameMode4Cards}" />
                            <ComboBoxItem Content="{DynamicResource Lobby_GameMode6Cards}" />
                            <ComboBoxItem Content="{DynamicResource Lobby_GameMode8Cards}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="0" BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,0,0,1" Margin="40,32,40,0" VerticalAlignment="Bottom" />

                <ItemsControl Grid.Row="1" Margin="80,48,80,48" ItemsSource="{Binding Players}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="brdLobbyPlayerCard" Style="{StaticResource LobbyCardNotReadyStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <Border Style="{StaticResource FriendAvatarBorderStyle}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="🐱"
                                                   Style="{StaticResource FriendAvatarEmojiStyle}"
                                                   FontFamily="Segoe UI Emoji" />
                                    </Border>
                                    <TextBlock x:Name="lblPlayerReadiness"
                                               Text="{DynamicResource Lobby_StatusNotReady}"
                                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding Nickname}"
                                               Style="{StaticResource FriendNameTextStyle}"
                                               HorizontalAlignment="Center" />
                                    <Border x:Name="brdLocalPlayerBadge"
                                            Style="{StaticResource RoleBadgeStyle}"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Lobby_LocalPlayerLabel}"
                                                   Style="{StaticResource BadgeTextActiveStyle}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                    <Setter TargetName="lblPlayerReadiness" Property="Text"
                                            Value="{DynamicResource Lobby_StatusReady}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                    <Setter TargetName="brdLocalPlayerBadge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="brdLobbyPlayerCard" Property="BorderBrush" Value="{StaticResource Brush_Accent}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,0,0,1" Margin="40,0,40,0" VerticalAlignment="Bottom" />

                <Grid Grid.Row="2" Margin="40,16,40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="scrChat" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderNickname}"
                                                   Style="{StaticResource LobbyChatSenderTextStyle}" />
                                        <TextBlock Text="{Binding Text}"
                                                   Style="{StaticResource LobbyChatMessageTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="3"
                                   Text="{DynamicResource Lobby_GuestCannotChatError}"
                                   Style="{StaticResource LobbyGuestChatNoticeTextStyle}" />
                        <TextBox x:Name="txtChatInput"
                                 Grid.Column="0"
                                 Style="{StaticResource FieldStyle}"
                                 Height="42"
                                 Tag="{DynamicResource Lobby_ChatPlaceholder}"
                                 Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsChatEnabled}"
                                 PreviewTextInput="OnChatPreviewTextInput"
                                 DataObject.Pasting="OnChatPasting"
                                 AcceptsReturn="False" AcceptsTab="False">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Content="{DynamicResource Lobby_SendChatButton}"
                                Style="{StaticResource ActionPrimarySmallButtonStyle}"
                                Width="80"
                                Height="42"
                                Margin="0"
                                Command="{Binding SendChatCommand}" />
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource SidePanelRightBorderStyle}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="{DynamicResource Lobby_PlayersReadyTitle}"
                               Style="{StaticResource StatCardLabelStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                    <TextBlock Text=""
                               FontSize="48"
                               FontWeight="Black"
                               Foreground="{StaticResource Brush_Gold}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />
                    <TextBlock Text="{DynamicResource Lobby_ReadyHint}"
                               Style="{StaticResource StatusTextOfflineStyle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</local:LocalizableScreen>