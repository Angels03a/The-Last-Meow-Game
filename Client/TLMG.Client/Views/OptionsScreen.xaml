<local:LocalizableScreen x:Class="TLMG.Client.Views.OptionsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush_BackgroundPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Options_Title}"
                           Style="{StaticResource SidebarTitleTextStyle}" />

                <Button Grid.Row="2"
                        x:Name="btnBack"
                        Content="{DynamicResource Options_BackButton}"
                        Style="{StaticResource SidebarBackButtonStyle}"
                        Command="{Binding BackCommand}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource OptionsContentPanelStyle}">
                <TextBlock Text="{DynamicResource Options_SectionTitle}"
                           Style="{StaticResource OptionsMainTitleStyle}" />

                <Border Style="{StaticResource OptionsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Options_LanguageLabel}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnLanguageEnglish"
                                    Content="US English"
                                    Style="{StaticResource LanguageButtonInactiveStyle}"
                                    Command="{Binding ChangeToEnglishCommand}" />
                            <Button x:Name="btnLanguageSpanish"
                                    Content="ES Español"
                                    Style="{StaticResource LanguageButtonActiveStyle}"
                                    Command="{Binding ChangeToSpanishCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Options_AudioLabel}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,16" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎵" Style="{StaticResource OptionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Options_MusicLabel}" Style="{StaticResource OptionLabelStyle}" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" />
                        </Grid>

                        <Grid Margin="0,16,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔈" Style="{StaticResource OptionSmallIconStyle}" />
                            <Slider Grid.Column="1"
                                    Style="{StaticResource CustomSliderStyle}"
                                    Maximum="100"
                                    Value="{Binding MusicVolume, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="🔊" Style="{StaticResource OptionSmallIconStyle}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3" Text="{Binding MusicVolumeText}" Style="{StaticResource OptionValueTextStyle}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔊" Style="{StaticResource OptionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Options_SoundEffectsLabel}" Style="{StaticResource OptionLabelStyle}" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" />
                        </Grid>

                        <Grid Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔈" Style="{StaticResource OptionSmallIconStyle}" />
                            <Slider Grid.Column="1"
                                    Style="{StaticResource CustomSliderStyle}"
                                    Maximum="100"
                                    Value="{Binding SoundEffectsVolume, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="🔊" Style="{StaticResource OptionSmallIconStyle}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3" Text="{Binding SoundEffectsVolumeText}" Style="{StaticResource OptionValueTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Options_NotificationsLabel}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,16" />
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Options_GameInvitesTitle}"
                                           Style="{StaticResource OptionLabelStyle}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{DynamicResource Options_GameInvitesDescription}"
                                           Style="{StaticResource OptionDescriptionStyle}" />
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="True"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="{DynamicResource Options_ResetButton}"
                        Style="{StaticResource OptionsResetButtonStyle}"
                        Command="{Binding ResetCommand}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:LocalizableScreen>