<local:LocalizableScreen x:Class="TLMG.Client.Views.LoginScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             xmlns:behaviors="clr-namespace:TLMG.Client.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             behaviors:WaitCursorBehavior.IsBusy="{Binding IsBusy}">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LoginHeroEmojiContainerStyle"
                   TargetType="StackPanel"
                   BasedOn="{StaticResource HeroEmojiContainerStyle}">
                <Setter Property="Margin" Value="18,0" />
            </Style>
            <Style x:Key="LoginHeroEmojiStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource HeroEmojiStyle}">
                <Setter Property="FontSize" Value="64" />
                <Setter Property="Foreground" Value="{StaticResource Brush_White}" />
            </Style>
            <Style x:Key="LoginHeroTitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource HeroTitleTextStyle}">
                <Setter Property="FontSize" Value="46" />
            </Style>
            <Style x:Key="LoginHeroSubtitleStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource HeroSubtitleTextStyle}">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background= "{StaticResource Brush_BackgroundDark}">
            <Ellipse Style="{StaticResource HeroBackgroundGlowStyle}" />

            <StackPanel Style="{StaticResource HeroContentPanelStyle}"
                        VerticalAlignment="Top"
                        Margin="0,120,0,0">
                <StackPanel Style="{StaticResource HeroEmojiRowStyle}">
                    <StackPanel Style="{StaticResource LoginHeroEmojiContainerStyle}">
                        <TextBlock Text="🐱" Style="{StaticResource LoginHeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LoginHeroEmojiContainerStyle}">
                        <TextBlock Text="🧟" Style="{StaticResource LoginHeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LoginHeroEmojiContainerStyle}">
                        <TextBlock Text="🚀" Style="{StaticResource LoginHeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LoginHeroEmojiContainerStyle}">
                        <TextBlock Text="💀" Style="{StaticResource LoginHeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LoginHeroEmojiContainerStyle}">
                        <TextBlock Text="🐈‍" Style="{StaticResource LoginHeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource LoginHeroEmojiContainerStyle}">
                        <TextBlock Text="🧛‍♀" Style="{StaticResource LoginHeroEmojiStyle}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{DynamicResource Login_Title}"
                           Style="{StaticResource LoginHeroTitleStyle}" />
                <TextBlock Text="{DynamicResource Login_Subtitle}"
                           Style="{StaticResource LoginHeroSubtitleStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource SidePanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Style="{StaticResource SidePanelContentStyle}">
                    <Grid Style="{StaticResource AuthenticationTabsGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                            Content="{DynamicResource Login_TabLogIn}"
                            Style="{StaticResource TabButtonActiveStyle}" />
                        <Button Grid.Column="1"
                            Content="{DynamicResource Login_TabCreateAccount}"
                            Style="{StaticResource TabButtonInactiveStyle}"
                            Command="{Binding CreateAccountCommand}" />
                    </Grid>

                    <TextBlock Text="{DynamicResource Login_EmailLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldStyle}" />
                    <TextBlock DataContext="{Binding EmailError}"
                           Text="{Binding Text}"
                           Style="{StaticResource StatusMessageTextStyle}" />

                    <TextBlock Text="{DynamicResource Login_PasswordLabel}"
                           Style="{StaticResource FieldLabelTextStyle}" />
                    <Grid>
                        <PasswordBox Style="{StaticResource FieldStyle}"
                                 Visibility="{Binding IsPasswordHidden,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"
                                 behaviors:PasswordBindingBehavior.BindPassword="True"
                                 behaviors:PasswordBindingBehavior.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldStyle}"
                             Visibility="{Binding IsPasswordVisible,
                                 Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="●"
                            Style="{StaticResource PasswordToggleButtonStyle}"
                            ToolTip="{DynamicResource Login_ShowPasswordHint}"
                            Command="{Binding TogglePasswordVisibilityCommand}" />
                    </Grid>

                    <Button Style="{StaticResource RightAlignedLinkButtonStyle}"
                        Command="{Binding ForgotPasswordCommand}">
                        <TextBlock Text="{DynamicResource Login_ForgotPassword}"
                               TextDecorations="Underline" />
                    </Button>

                    <Button Content="{DynamicResource Login_LogInButton}"
                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                        Command="{Binding LogInCommand}" />

                    <Button Content="{DynamicResource Login_PlayAsGuestButton}"
                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                        Command="{Binding PlayAsGuestCommand}" />

                    <Button Content="{DynamicResource Recovery_Retry}"
                            Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                            Command="{Binding RetryRecoveryCommand}"
                            Visibility="{Binding CanRetryRecovery, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock DataContext="{Binding FormMessage}"
                           Text="{Binding Text}"
                           Style="{StaticResource StatusMessageTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                    <Button Style="{StaticResource LanguageButtonInactiveStyle}"
                            x:Name="btnLanguageEnglish"
                            Content="EN-US"
                            Command="{Binding ChangeToEnglishCommand}" />
                    <Button Style="{StaticResource LanguageButtonActiveStyle}"
                            x:Name="btnLanguageSpanish"
                            Content="ES-MX"
                            Margin="0"
                            Command="{Binding ChangeToSpanishCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:LocalizableScreen>