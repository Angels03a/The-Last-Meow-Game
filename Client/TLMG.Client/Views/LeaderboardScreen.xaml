<local:LocalizableScreen x:Class="TLMG.Client.Views.LeaderboardScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="PlayerRankRowTemplate">
                <Border Style="{StaticResource TableRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding RankLabel}" Style="{StaticResource TableRankTextStyle}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource PlayerAvatarCircleStyle}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarImagePath}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding PlayerName}" Style="{StaticResource TableRowPlayerNameStyle}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding ScoreLabel}" Style="{StaticResource SidebarStatValuePrimaryStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Wins}" Style="{StaticResource TableWinsTextStyle}" HorizontalAlignment="Right" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource WinRateTrackStyle}">
                                <Rectangle x:Name="rectWinRateFill" Style="{StaticResource WinRateFillStyle}" Width="{Binding WinRateBarWidth}" />
                            </Border>
                            <TextBlock Text="{Binding WinRateLabel}" Style="{StaticResource WinRateLabelTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsHighWinRate}" Value="True">
                        <Setter TargetName="rectWinRateFill" Property="Fill" Value="{StaticResource Brush_Online}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource LeaderboardSidebarBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Leaderboard_Title}" Style="{StaticResource SidebarTitleTextStyle}" />

                <Button Grid.Row="1" Style="{StaticResource SidebarFilterButtonActiveStyle}" Command="{Binding FilterAllTimeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏆" Style="{StaticResource FilterButtonIconStyle}" />
                        <TextBlock Text="{DynamicResource Leaderboard_HeaderFilterAllTimeButton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Grid.Row="3" Style="{StaticResource HighlightedInfoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Leaderboard_YourStandingLabel}" Style="{StaticResource StandingSectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🐱" Style="{StaticResource StandingAvatarEmojiStyle}" />
                            <StackPanel>
                                <TextBlock Text="{Binding UserStandingRankLabel}" Style="{StaticResource SidebarStatValueAccentStyle}" />
                                <TextBlock Text="{Binding UserStandingPointsLabel}" Style="{StaticResource SubtitleTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Grid.Row="4" Content="{DynamicResource Leaderboard_BackButton}" Style="{StaticResource SidebarBackButtonStyle}" Command="{Binding BackCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{StaticResource LeaderboardHeaderRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Leaderboard_HeaderTitle}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Style="{StaticResource LeaderboardUpdatedLabelStyle}" />
                </StackPanel>

                <Button Grid.Column="1" Content="{DynamicResource Leaderboard_HeaderFilterAllTimeButton}" Style="{StaticResource HeaderFilterButtonActiveStyle}" Command="{Binding FilterAllTimeCommand}" />
            </Grid>

            <Grid Grid.Row="1" Style="{StaticResource PodiumSectionStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <Image Source="{Binding SecondPlace.AvatarImagePath}" Width="64" Height="64" Margin="0,0,0,8" Stretch="Uniform" />
                    <TextBlock Text="{Binding SecondPlace.PlayerName}" Style="{StaticResource PodiumPlayerNameStyle}" />
                    <TextBlock Text="{Binding SecondPlaceScoreLabel}" Style="{StaticResource PodiumPlayerPointsStyle}" />
                    <Border Style="{StaticResource PodiumStepSecondPlaceStyle}">
                        <TextBlock Text="🥈" Style="{StaticResource PodiumMedalEmojiStyle}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <Image Source="{Binding FirstPlace.AvatarImagePath}" Width="80" Height="80" Margin="0,0,0,8" Stretch="Uniform" />
                    <TextBlock Text="{Binding FirstPlace.PlayerName}" Style="{StaticResource PodiumPlayerNameStyle}" />
                    <TextBlock Text="{Binding FirstPlaceScoreLabel}" Style="{StaticResource PodiumPlayerPointsStyle}" />
                    <Border Style="{StaticResource PodiumStepFirstPlaceStyle}">
                        <TextBlock Text="🥇" Style="{StaticResource PodiumMedalEmojiStyle}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Image Source="{Binding ThirdPlace.AvatarImagePath}" Width="64" Height="64" Margin="0,0,0,8" Stretch="Uniform" />
                    <TextBlock Text="{Binding ThirdPlace.PlayerName}" Style="{StaticResource PodiumPlayerNameStyle}" />
                    <TextBlock Text="{Binding ThirdPlaceScoreLabel}" Style="{StaticResource PodiumPlayerPointsStyle}" />
                    <Border Style="{StaticResource PodiumStepThirdPlaceStyle}">
                        <TextBlock Text="🥉" Style="{StaticResource PodiumMedalEmojiStyle}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyle}">
                <!-- Las cabeceras se quedan igual -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Leaderboard_ColumnRank}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Leaderboard_ColumnPlayer}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource Leaderboard_ColumnScore}" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Left" Margin="65,0,0,0" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource Leaderboard_ColumnWins}" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Left" Margin="43,0,0,0" />
                    <TextBlock Grid.Column="4" Text="{DynamicResource Leaderboard_ColumnWinRate}" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Left" Width="160" TextAlignment="Right" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" Style="{StaticResource RankedPlayersScrollViewerStyle}">
                <ItemsControl ItemsSource="{Binding RankedPlayers}" ItemTemplate="{StaticResource PlayerRankRowTemplate}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</local:LocalizableScreen>