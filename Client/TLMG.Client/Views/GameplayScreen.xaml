<local:LocalizableScreen x:Class="TLMG.Client.Views.GameplayScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="OpponentSlotContentStyle" TargetType="ContentControl">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}"
                                 Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PileButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CommandParameter.PileCards.Count, RelativeSource={RelativeSource Self}}"
                                 Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CommandParameter, RelativeSource={RelativeSource Self}}"
                                 Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadablePileCardStyle" TargetType="Border"
                   BasedOn="{StaticResource GameplayMiniCardBorderStyle}">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="76" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush_AccentLight}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style x:Key="ReadablePileSymbolStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource GameplayMiniCardEmojiStyle}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Foreground" Value="{StaticResource Brush_White}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style x:Key="ReadablePlayerNameStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource GameplayPlayerNameTextStyle}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource Brush_White}" />
                <Setter Property="MaxWidth" Value="140" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="PunishmentCardButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource GameplayHandCardItemButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="True">
                        <Setter Property="Cursor" Value="Hand" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsEnabled" Value="True" />
                            <Condition Property="IsMouseOver" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{StaticResource Brush_White}" />
                        <Setter Property="BorderThickness" Value="3" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="PileCardTemplate">
                <Border Style="{StaticResource ReadablePileCardStyle}">
                    <TextBlock Text="{Binding Symbol}"
                               Style="{StaticResource ReadablePileSymbolStyle}" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ScoreboardPlayerTemplate">
                <Grid Style="{StaticResource GameplayScoreboardCellStyle}"
                      ToolTip="{Binding Nickname}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="🐱"
                               Style="{StaticResource GameplayScoreboardEmojiStyle}" Foreground="{StaticResource Brush_White}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Nickname}"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource GameplayScoreboardNameStyle}" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource GameplayScoreboardValueStyle}">
                        <Run Text="{Binding LivesCount, Mode=OneWay}" />
                        <Run Text="/" />
                        <Run Text="{Binding MaximumLivesCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="3"
                               Text="🎯"
                               Style="{StaticResource GameplayScoreboardEmojiStyle}" Foreground="{StaticResource Brush_White}"
                               Visibility="{Binding IsInTurn,
                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OpponentTemplate">
                <StackPanel x:Name="pnlOpponent"
                            Tag="{Binding Nickname}"
                            MouseRightButtonUp="PnlOpponent_MouseRightButtonUp">
                    <Grid Style="{StaticResource GameplayAvatarGridStyle}">
                        <Border Style="{StaticResource GameplayAvatarBorderStyle}">
                            <TextBlock Text="🐱"
                                       Style="{StaticResource GameplayAvatarEmojiStyle}" Foreground="{StaticResource Brush_White}" />
                        </Border>
                        <TextBlock Text="🎯"
                                   Style="{StaticResource GameplayTurnMarkerTextStyle}" Foreground="{StaticResource Brush_White}"
                                   Visibility="{Binding IsInTurn,
                                       Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Style="{StaticResource GameplayWinBadgeBorderStyle}">
                            <TextBlock Text="{Binding LivesCount}"
                                       Style="{StaticResource GameplayWinBadgeTextStyle}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Nickname}"
                               Style="{StaticResource ReadablePlayerNameStyle}" />
                    <Button Style="{StaticResource PileButtonStyle}"
                            Command="{Binding DataContext.RevealCardCommand,
                                     RelativeSource={RelativeSource AncestorType={x:Type local:LocalizableScreen}}}"
                            CommandParameter="{Binding}"
                            ToolTip="{DynamicResource Gameplay_RevealPile}">
                        <Viewbox MaxWidth="140" MaxHeight="76" Stretch="Uniform" StretchDirection="DownOnly">
                            <ItemsControl ItemsSource="{Binding PileCards}"
                                      ItemTemplate="{StaticResource PileCardTemplate}"
                                      Style="{StaticResource GameplayMiniCardsHostStyle}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource GameplayMiniCardsPanelStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Viewbox>
                    </Button>
                    <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Brush_White}"
                               FontSize="14" FontWeight="SemiBold">
                        <Run Text="{DynamicResource Gameplay_HiddenCardsLabel}" />
                        <Run Text="{Binding HiddenPileCardCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding HandCardCount, StringFormat='🃏 {0}'}"
                               HorizontalAlignment="Center"
                               Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsEliminated}" Value="True">
                        <Setter TargetName="pnlOpponent" Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource GameplayHeaderBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Gameplay_Title}"
                               Style="{StaticResource GameplayHeaderTitleTextStyle}" />

                    <Border Grid.Column="1" Style="{StaticResource GameplayRoundPillBorderStyle}">
                        <TextBlock x:Name="lblRoundPhase"
                                   Style="{StaticResource GameplayRoundPillTextStyle}" />
                    </Border>

                    <ItemsControl Grid.Column="2"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Board.Players}"
                                  ItemTemplate="{StaticResource ScoreboardPlayerTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  x:Name="grdTable"
                  Background="{StaticResource Brush_BackgroundDark}"
                  MouseLeftButtonDown="GrdTable_MouseLeftButtonDown">
                <Grid Style="{StaticResource GameplayTableAreaGridStyle}">
                    <Ellipse Style="{StaticResource GameplayTableEllipseStyle}" />

                    <TextBlock Visibility="{Binding HasMatchView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GameplayTableHintTextStyle}">
                                <Setter Property="Text" Value="{DynamicResource Gameplay_TableHint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PhaseLabelKey}" Value="Gameplay_PhaseBiddingLabel">
                                        <Setter Property="Text" Value="{DynamicResource Gameplay_TableHintBetting}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PhaseLabelKey}" Value="Gameplay_PhaseChallengeReadyLabel">
                                        <Setter Property="Text" Value="{DynamicResource Gameplay_PhaseChallengeReadyLabel}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PhaseLabelKey}" Value="Gameplay_PhasePunishmentPendingLabel">
                                        <Setter Property="Text" Value="{DynamicResource Gameplay_PhasePunishmentPendingLabel}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PhaseLabelKey}" Value="Gameplay_PhaseMatchFinishedLabel">
                                        <Setter Property="Text" Value="{DynamicResource Gameplay_PhaseMatchFinishedLabel}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Style="{StaticResource GameplayCenterCardsPanelStyle}" Orientation="Vertical"
                                Visibility="{Binding Board.HasChallenge,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource GameplayCurrentBidLabelStyle}">
                            <Run Text="{DynamicResource Gameplay_RevealProgress}" />
                            <Run Text="{Binding Board.RevealedCount, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding Board.PromisedCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GameplayCurrentBidLabelStyle}">
                                    <Setter Property="Text" Value="{DynamicResource Gameplay_ChallengeInProgress}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Board.ChallengeOutcome}" Value="Succeeded">
                                            <Setter Property="Text" Value="{DynamicResource Gameplay_ChallengeSucceeded}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Board.ChallengeOutcome}" Value="Failed">
                                            <Setter Property="Text" Value="{DynamicResource Gameplay_ChallengeFailed}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Border Style="{StaticResource GameplayCurrentBidBorderStyle}">
                        <StackPanel Style="{StaticResource GameplayCurrentBidPanelStyle}">
                            <TextBlock Text="{DynamicResource Gameplay_CurrentBidLabel}"
                                       Style="{StaticResource GameplayCurrentBidLabelStyle}" />
                            <TextBlock Text="{Binding CurrentBidAmount}"
                                       Style="{StaticResource GameplayCurrentBidValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{DynamicResource Gameplay_ModerationHint}"
                           Style="{StaticResource GameplayModerationHintTextStyle}" />

                <TextBlock Text="{DynamicResource Gameplay_MatchUnavailableLabel}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,60,0,0"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush_Error}"
                           Panel.ZIndex="1"
                           Visibility="{Binding IsMatchUnavailable,
                               Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Style="{StaticResource GameplayOpponentLeftPanelStyle}">
                    <ContentControl Content="{Binding Board.OpponentLeft}"
                                    ContentTemplate="{StaticResource OpponentTemplate}"
                                    Style="{StaticResource OpponentSlotContentStyle}" />
                </StackPanel>

                <StackPanel Style="{StaticResource GameplayOpponentTopLeftPanelStyle}">
                    <ContentControl Content="{Binding Board.OpponentTopLeft}"
                                    ContentTemplate="{StaticResource OpponentTemplate}"
                                    Style="{StaticResource OpponentSlotContentStyle}" />
                </StackPanel>

                <StackPanel Style="{StaticResource GameplayOpponentTopPanelStyle}">
                    <ContentControl Content="{Binding Board.OpponentTop}"
                                    ContentTemplate="{StaticResource OpponentTemplate}"
                                    Style="{StaticResource OpponentSlotContentStyle}" />
                </StackPanel>

                <StackPanel Style="{StaticResource GameplayOpponentTopRightPanelStyle}">
                    <ContentControl Content="{Binding Board.OpponentTopRight}"
                                    ContentTemplate="{StaticResource OpponentTemplate}"
                                    Style="{StaticResource OpponentSlotContentStyle}" />
                </StackPanel>

                <StackPanel Style="{StaticResource GameplayOpponentRightPanelStyle}">
                    <ContentControl Content="{Binding Board.OpponentRight}"
                                    ContentTemplate="{StaticResource OpponentTemplate}"
                                    Style="{StaticResource OpponentSlotContentStyle}" />
                </StackPanel>

                <Border x:Name="brdPlayerContextMenu" Style="{StaticResource GameplayContextMenuBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ContextMenuTitle}"
                                   Style="{StaticResource ContextMenuHeaderStyle}" />
                        <Button Content="{DynamicResource Gameplay_MenuReportButton}"
                                Style="{StaticResource GameplayContextMenuReportItemStyle}"
                                Command="{Binding ReportPlayerCommand}" />
                        <Button Content="{DynamicResource Gameplay_MenuKickButton}"
                                Style="{StaticResource GameplayContextMenuKickItemStyle}"
                                Command="{Binding KickPlayerCommand}" />
                        <Button Content="{DynamicResource Gameplay_MenuBlockButton}"
                                Style="{StaticResource ContextMenuDangerItemStyle}"
                                Command="{Binding BlockPlayerCommand}" />
                        <Button Content="{DynamicResource Gameplay_MenuCancelButton}"
                                Style="{StaticResource GameplayContextMenuCancelItemStyle}"
                                Click="BtnMenuCancel_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource GameplayBottomBarBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource GameplayLocalPlayerPanelStyle}">
                        <Grid Style="{StaticResource GameplayLocalAvatarGridStyle}">
                            <Border Style="{StaticResource GameplayLocalAvatarBorderStyle}">
                                <TextBlock Text="🐱"
                                           Style="{StaticResource GameplayLocalAvatarEmojiStyle}" Foreground="{StaticResource Brush_White}" />
                            </Border>
                            <TextBlock Text="🎯"
                                       Style="{StaticResource GameplayTurnMarkerTextStyle}" Foreground="{StaticResource Brush_White}"
                                       Visibility="{Binding Board.IsLocalPlayerTurn,
                                           Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border Style="{StaticResource GameplayWinBadgeBorderStyle}">
                                <TextBlock Text="{Binding Board.LocalPlayer.LivesCount}"
                                           Style="{StaticResource GameplayWinBadgeTextStyle}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Board.LocalPlayer.Nickname}"
                                   Style="{StaticResource GameplayLocalPlayerNameTextStyle}" Foreground="{StaticResource Brush_White}" FontSize="14" />
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Brush_White}"
                                   FontSize="14" FontWeight="SemiBold">
                            <Run Text="{DynamicResource Gameplay_HiddenCardsLabel}" />
                            <Run Text="{Binding Board.LocalPlayer.HiddenPileCardCount, Mode=OneWay}" />
                        </TextBlock>
                        <Button Style="{StaticResource PileButtonStyle}"
                                Command="{Binding RevealCardCommand}" CommandParameter="{Binding Board.LocalPlayer}"
                                ToolTip="{DynamicResource Gameplay_RevealPile}">
                            <Viewbox MaxWidth="140" MaxHeight="76" Stretch="Uniform" StretchDirection="DownOnly">
                                <ItemsControl ItemsSource="{Binding Board.OwnPileCards}"
                                          ItemTemplate="{StaticResource PileCardTemplate}"
                                          Style="{StaticResource GameplayMiniCardsHostStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Style="{StaticResource GameplayMiniCardsPanelStyle}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Gameplay_YourHandLabel}"
                                   Style="{StaticResource GameplayHandLabelTextStyle}" />

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding Board.HandCards}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.HandColumnCount, 
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GameplayHandCardItemButtonStyle}"
                                            Command="{Binding DataContext.PlaceCardCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource GameplayHandCardItemEmojiStyle}" Foreground="{StaticResource Brush_White}" />
                                            <TextBlock Style="{StaticResource GameplayHandCardItemLabelStyle}" Foreground="{StaticResource Brush_White}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <StackPanel Grid.Column="3" Style="{StaticResource GameplayActionsPanelStyle}">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Visibility="{Binding Board.CanPlaceBet,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Gameplay_BetLimitsLabel}"
                                           Style="{StaticResource GameplayCurrentBidLabelStyle}" />
                                <TextBlock Style="{StaticResource GameplayCurrentBidLabelStyle}">
                                    <Run Text="{Binding Board.MinimumBetValue}" />
                                    <Run Text="–" />
                                    <Run Text="{Binding Board.MaximumBetValue}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Gameplay_BetLeaderLabel}"
                                       Style="{StaticResource GameplayCurrentBidLabelStyle}" />
                            <TextBlock Text="{Binding Board.BetLeaderName}"
                                       Style="{StaticResource GameplayCurrentBidLabelStyle}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        </StackPanel>
                        <Border Style="{StaticResource GameplayBidSelectorBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−"
                                        Style="{StaticResource GameplayBidStepButtonStyle}"
                                        Command="{Binding DecreaseBetCommand}" />
                                <TextBlock Text="{Binding BidAmount}"
                                           Style="{StaticResource GameplayBidValueTextStyle}" />
                                <Button Content="+"
                                        Style="{StaticResource GameplayBidStepButtonStyle}"
                                        Command="{Binding IncreaseBetCommand}" />
                            </StackPanel>
                        </Border>
                        <Button Content="{DynamicResource Gameplay_ChallengeButton}"
                                Style="{StaticResource GameplayChallengeButtonStyle}"
                                Command="{Binding PlaceBetCommand}" />
                        <Button Content="{DynamicResource Gameplay_SurrenderButton}"
                                Style="{StaticResource GameplaySurrenderButtonStyle}"
                                Command="{Binding WithdrawBetCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="0" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource ModalBorderStyle}"
                Visibility="{Binding Board.HasPunishment, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="20" MaxWidth="650">
                <TextBlock Text="{DynamicResource Gameplay_PunishmentTitle}" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource Brush_White}" HorizontalAlignment="Center" />
                <TextBlock FontSize="16" Foreground="{StaticResource Brush_White}" Margin="0,10,0,0">
                    <Run Text="{DynamicResource Gameplay_PunishmentChooser}" />
                    <Run Text="{Binding Board.PunishmentChooserName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="16" Foreground="{StaticResource Brush_White}">
                    <Run Text="{DynamicResource Gameplay_PunishmentTarget}" />
                    <Run Text="{Binding Board.PunishedPlayerName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{DynamicResource Gameplay_PunishmentDeadline}" FontSize="14" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush_White}" Margin="0,8,0,8" />
                <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush_White}"
                           Margin="0,0,0,8"
                           Visibility="{Binding Board.CanChoosePunishment,
                               Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource Gameplay_PunishmentChooseOwn}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Board.IsBlindPunishment}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource Gameplay_PunishmentChooseBlind}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>                <ItemsControl ItemsSource="{Binding Board.PunishmentCards}"
                              Visibility="{Binding Board.CanChoosePunishment,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ChoosePunishmentCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Style="{StaticResource PunishmentCardButtonStyle}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource GameplayHandCardItemEmojiStyle}"
                                                   Foreground="{StaticResource Brush_White}" />
                                        <TextBlock Style="{StaticResource GameplayHandCardItemLabelStyle}"
                                                   Foreground="{StaticResource Brush_White}" />
                                    </StackPanel>
                                    <Border Background="{StaticResource Brush_BackgroundDark}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlind}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="🎴" FontSize="28" Foreground="{StaticResource Brush_White}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource SidePanelRightBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Gameplay_ChatTitle}"
                           Style="{StaticResource GameplayChatTitleTextStyle}" />

                <Button Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,16,0"
                        Content="{DynamicResource Gameplay_ExitButton}"
                        Style="{StaticResource GameplayExitButtonStyle}"
                        Command="{Binding ExitCommand}" />

                <ScrollViewer Grid.Row="1" Style="{StaticResource GameplayChatMessagesScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource GameplayChatMessageTextStyle}">
                                    <Run Text="{Binding SenderNickname, Mode=OneWay}" 
                                         Style="{StaticResource GameplayChatAuthorRunStyle}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource GameplayChatFooterBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChatInput"
                                 Grid.Column="0"
                                 PreviewTextInput="OnChatPreviewTextInput"
                                 DataObject.Pasting="OnChatPasting"
                                 Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{DynamicResource Gameplay_ChatPlaceholder}"
                                 Style="{StaticResource GameplayChatInputStyle}" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource Gameplay_SendChatButton}"
                                Style="{StaticResource GameplaySendChatButtonStyle}"
                                Command="{Binding SendChatCommand}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Style="{StaticResource GameplayDemoPanelStyle}"
                            Visibility="{Binding IsDemoPanelVisible,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Gameplay_DemoTitle}"
                               Style="{StaticResource GameplayDemoTitleTextStyle}" />
                    <Button Content="{DynamicResource Gameplay_DemoRevealCardsButton}"
                            Style="{StaticResource GameplayDemoButtonStyle}"
                            Command="{Binding DemoRevealCardsCommand}" />
                    <Button Content="{DynamicResource Gameplay_DemoGameOverButton}"
                            Style="{StaticResource GameplayDemoButtonStyle}"
                            Command="{Binding DemoGameOverCommand}" />
                    <Button Content="{DynamicResource Gameplay_DemoInactivityButton}"
                            Style="{StaticResource GameplayDemoButtonStyle}"
                            Command="{Binding DemoInactivityCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:LocalizableScreen>