<local:LocalizableScreen x:Class="TLMG.Client.Views.GameplayScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource GameplayHeaderBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Gameplay_Title}"
                               Style="{StaticResource GameplayHeaderTitleTextStyle}" />

                    <Border Grid.Column="1" Style="{StaticResource GameplayRoundPillBorderStyle}">
                        <TextBlock x:Name="lblRoundPhase"
                                   Style="{StaticResource GameplayRoundPillTextStyle}" />
                    </Border>

                    <StackPanel Grid.Column="2" Style="{StaticResource GameplayScoreboardPanelStyle}">
                        <StackPanel Style="{StaticResource GameplayScoreboardItemStyle}">
                            <TextBlock Text="🐯"
                                       Style="{StaticResource GameplayScoreboardEmojiStyle}" />
                            <TextBlock Text="NyanProwler"
                                       Style="{StaticResource GameplayScoreboardNameStyle}" />
                            <TextBlock Style="{StaticResource GameplayScoreboardValueStyle}">
                                <Run Text="1/" />
                                <Run Text="{Binding ChallengesToWin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GameplayScoreboardItemStyle}">
                            <TextBlock Text="🐱"
                                       Style="{StaticResource GameplayScoreboardEmojiStyle}" />
                            <TextBlock Text="CatNapper9000"
                                       Style="{StaticResource GameplayScoreboardNameStyle}" />
                            <TextBlock Style="{StaticResource GameplayScoreboardValueStyle}">
                                <Run Text="0/" />
                                <Run Text="{Binding ChallengesToWin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GameplayScoreboardItemStyle}">
                            <TextBlock Text="🐱"
                                       Style="{StaticResource GameplayScoreboardEmojiStyle}" />
                            <TextBlock Text="WhiskerKnight"
                                       Style="{StaticResource GameplayScoreboardNameStyle}" />
                            <TextBlock Style="{StaticResource GameplayScoreboardValueStyle}">
                                <Run Text="1/" />
                                <Run Text="{Binding ChallengesToWin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Style="{StaticResource GameplayScoreboardItemStyle}">
                            <TextBlock Text="🐱"
                                       Style="{StaticResource GameplayScoreboardEmojiStyle}" />
                            <TextBlock Text="GraveyardPaws"
                                       Style="{StaticResource GameplayScoreboardNameStyle}" />
                            <TextBlock Style="{StaticResource GameplayScoreboardValueStyle}">
                                <Run Text="0/" />
                                <Run Text="{Binding ChallengesToWin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="{DynamicResource Gameplay_ExitButton}"
                            Style="{StaticResource GameplayExitButtonStyle}"
                            Command="{Binding ExitCommand}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  x:Name="grdTable"
                  Background="{StaticResource Brush_BackgroundDark}"
                  MouseLeftButtonDown="GrdTable_MouseLeftButtonDown">
                <Ellipse Style="{StaticResource GameplayTableEllipseStyle}" />

                <TextBlock Text="{DynamicResource Gameplay_ModerationHint}"
                           Style="{StaticResource GameplayModerationHintTextStyle}" />

                <TextBlock Text="{DynamicResource Gameplay_TableHint}"
                           Style="{StaticResource GameplayTableHintTextStyle}" />

                <StackPanel Style="{StaticResource GameplayCenterCardsPanelStyle}">
                    <Border Style="{StaticResource GameplayCenterCardFirstStyle}">
                        <TextBlock Text="🎴"
                                   Style="{StaticResource GameplayCenterCardEmojiStyle}" />
                    </Border>
                    <Border Style="{StaticResource GameplayCenterCardSecondStyle}">
                        <TextBlock Text="🎴"
                                   Style="{StaticResource GameplayCenterCardEmojiStyle}" />
                    </Border>
                    <Border Style="{StaticResource GameplayCenterCardThirdStyle}">
                        <TextBlock Text="🎴"
                                   Style="{StaticResource GameplayCenterCardEmojiStyle}" />
                    </Border>
                    <Border Style="{StaticResource GameplayCenterCardFourthStyle}">
                        <TextBlock Text="🎴"
                                   Style="{StaticResource GameplayCenterCardEmojiStyle}" />
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource GameplayCurrentBidBorderStyle}">
                    <StackPanel Style="{StaticResource GameplayCurrentBidPanelStyle}">
                        <TextBlock Text="{DynamicResource Gameplay_CurrentBidLabel}"
                                   Style="{StaticResource GameplayCurrentBidLabelStyle}" />
                        <TextBlock Text="{Binding CurrentBidAmount}"
                                   Style="{StaticResource GameplayCurrentBidValueStyle}" />
                    </StackPanel>
                </Border>

                <StackPanel Style="{StaticResource GameplayOpponentTopPanelStyle}"
                            Tag="NyanProwler"
                            MouseRightButtonUp="PnlOpponent_MouseRightButtonUp">
                    <Grid Style="{StaticResource GameplayAvatarGridStyle}">
                        <Border Style="{StaticResource GameplayAvatarBorderStyle}">
                            <TextBlock Text="🐯"
                                       Style="{StaticResource GameplayAvatarEmojiStyle}" />
                        </Border>
                        <Border Style="{StaticResource GameplayWinBadgeBorderStyle}">
                            <TextBlock Text="1"
                                       Style="{StaticResource GameplayWinBadgeTextStyle}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="NyanProwler"
                               Style="{StaticResource GameplayPlayerNameTextStyle}" />
                    <StackPanel Style="{StaticResource GameplayMiniCardsPanelStyle}">
                        <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                            <TextBlock Text="🎴"
                                       Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                        </Border>
                        <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                            <TextBlock Text="🎴"
                                       Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                        </Border>
                        <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                            <TextBlock Text="🎴"
                                       Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource GameplayOpponentLeftPanelStyle}"
                            Tag="CatNapper9000"
                            MouseRightButtonUp="PnlOpponent_MouseRightButtonUp">
                    <Grid Style="{StaticResource GameplayAvatarGridStyle}">
                        <Border Style="{StaticResource GameplayAvatarBorderStyle}">
                            <TextBlock Text="🐱"
                                       Style="{StaticResource GameplayAvatarEmojiStyle}" />
                        </Border>
                        <Border Style="{StaticResource GameplayWinBadgeBorderStyle}">
                            <TextBlock Text="0"
                                       Style="{StaticResource GameplayWinBadgeTextStyle}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="CatNapper9000"
                               Style="{StaticResource GameplayPlayerNameTextStyle}" />
                    <StackPanel Style="{StaticResource GameplayMiniCardsPanelStyle}">
                        <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                            <TextBlock Text="🎴"
                                       Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                        </Border>
                        <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                            <TextBlock Text="🎴"
                                       Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource GameplayOpponentRightPanelStyle}"
                            Tag="GraveyardPaws"
                            MouseRightButtonUp="PnlOpponent_MouseRightButtonUp">
                    <Grid Style="{StaticResource GameplayAvatarGridStyle}">
                        <Border Style="{StaticResource GameplayAvatarBorderStyle}">
                            <TextBlock Text="🐱"
                                       Style="{StaticResource GameplayAvatarEmojiStyle}" />
                        </Border>
                        <Border Style="{StaticResource GameplayWinBadgeBorderStyle}">
                            <TextBlock Text="0"
                                       Style="{StaticResource GameplayWinBadgeTextStyle}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="GraveyardPaws"
                               Style="{StaticResource GameplayPlayerNameTextStyle}" />
                    <StackPanel Style="{StaticResource GameplayMiniCardsPanelStyle}">
                        <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                            <TextBlock Text="🎴"
                                       Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                        </Border>
                        <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                            <TextBlock Text="🎴"
                                       Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="brdPlayerContextMenu" Style="{StaticResource GameplayContextMenuBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding ContextMenuTitle}"
                                   Style="{StaticResource ContextMenuHeaderStyle}" />
                        <Button Content="{DynamicResource Gameplay_MenuReportButton}"
                                Style="{StaticResource GameplayContextMenuReportItemStyle}"
                                Command="{Binding ReportPlayerCommand}" />
                        <Button Content="{DynamicResource Gameplay_MenuKickButton}"
                                Style="{StaticResource GameplayContextMenuKickItemStyle}"
                                Command="{Binding KickPlayerCommand}" />
                        <Button Content="{DynamicResource Gameplay_MenuBlockButton}"
                                Style="{StaticResource ContextMenuDangerItemStyle}"
                                Command="{Binding BlockPlayerCommand}" />
                        <Button Content="{DynamicResource Gameplay_MenuCancelButton}"
                                Style="{StaticResource GameplayContextMenuCancelItemStyle}"
                                Click="BtnMenuCancel_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource GameplayBottomBarBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource GameplayLocalPlayerPanelStyle}">
                        <Grid Style="{StaticResource GameplayLocalAvatarGridStyle}">
                            <Border Style="{StaticResource GameplayLocalAvatarBorderStyle}">
                                <TextBlock Text="🐱"
                                           Style="{StaticResource GameplayLocalAvatarEmojiStyle}" />
                            </Border>
                            <TextBlock Text="🎯"
                                       Style="{StaticResource GameplayTurnMarkerTextStyle}" />
                            <Border Style="{StaticResource GameplayWinBadgeBorderStyle}">
                                <TextBlock Text="1"
                                           Style="{StaticResource GameplayWinBadgeTextStyle}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="InterStella"
                                   Style="{StaticResource GameplayLocalPlayerNameTextStyle}" />
                        <StackPanel Style="{StaticResource GameplayMiniCardsPanelStyle}">
                            <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                                <TextBlock Text="🎴"
                                           Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                            </Border>
                            <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                                <TextBlock Text="🎴"
                                           Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                            </Border>
                            <Border Style="{StaticResource GameplayMiniCardBorderStyle}">
                                <TextBlock Text="🎴"
                                           Style="{StaticResource GameplayMiniCardEmojiStyle}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Gameplay_YourHandLabel}"
                                   Style="{StaticResource GameplayHandLabelTextStyle}" />

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding HandCards}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.HandColumnCount, 
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GameplayHandCardItemButtonStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource GameplayHandCardItemEmojiStyle}" />
                                            <TextBlock Style="{StaticResource GameplayHandCardItemLabelStyle}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <StackPanel Grid.Column="3" Style="{StaticResource GameplayActionsPanelStyle}">
                        <Border Style="{StaticResource GameplayBidSelectorBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−"
                                        Style="{StaticResource GameplayBidStepButtonStyle}"
                                        Command="{Binding DecreaseBidCommand}" />
                                <TextBlock Text="{Binding BidAmount}"
                                           Style="{StaticResource GameplayBidValueTextStyle}" />
                                <Button Content="+"
                                        Style="{StaticResource GameplayBidStepButtonStyle}"
                                        Command="{Binding IncreaseBidCommand}" />
                            </StackPanel>
                        </Border>
                        <Button Content="{DynamicResource Gameplay_ChallengeButton}"
                                Style="{StaticResource GameplayChallengeButtonStyle}" />
                        <Button Content="{DynamicResource Gameplay_SurrenderButton}"
                                Style="{StaticResource GameplaySurrenderButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource SidePanelRightBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Gameplay_ChatTitle}"
                           Style="{StaticResource GameplayChatTitleTextStyle}" />

                <ScrollViewer Grid.Row="1" Style="{StaticResource GameplayChatMessagesScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource GameplayChatMessageTextStyle}">
                                    <Run Text="{Binding SenderNickname, Mode=OneWay}" 
                                         Style="{StaticResource GameplayChatAuthorRunStyle}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource GameplayChatFooterBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChatInput"
                                 Grid.Column="0"
                                 PreviewTextInput="OnChatPreviewTextInput"
                                 DataObject.Pasting="OnChatPasting"
                                 Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{DynamicResource Gameplay_ChatPlaceholder}"
                                 Style="{StaticResource GameplayChatInputStyle}" />
                        <Button Grid.Column="1"
                                Content="{DynamicResource Gameplay_SendChatButton}"
                                Style="{StaticResource GameplaySendChatButtonStyle}"
                                Command="{Binding SendChatCommand}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Style="{StaticResource GameplayDemoPanelStyle}">
                    <TextBlock Text="{DynamicResource Gameplay_DemoTitle}"
                               Style="{StaticResource GameplayDemoTitleTextStyle}" />
                    <Button Content="{DynamicResource Gameplay_DemoRevealCardsButton}"
                            Style="{StaticResource GameplayDemoButtonStyle}"
                            Command="{Binding DemoRevealCardsCommand}" />
                    <Button Content="{DynamicResource Gameplay_DemoGameOverButton}"
                            Style="{StaticResource GameplayDemoButtonStyle}"
                            Command="{Binding DemoGameOverCommand}" />
                    <Button Content="{DynamicResource Gameplay_DemoInactivityButton}"
                            Style="{StaticResource GameplayDemoButtonStyle}"
                            Command="{Binding DemoInactivityCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:LocalizableScreen>