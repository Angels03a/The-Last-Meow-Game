<local:LocalizableScreen x:Class="TLMG.Client.Views.NewPasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG.Client;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}" Width="680">
            <StackPanel>
                <StackPanel Style="{StaticResource StepTrackerContainerStyle}">
                    <Border Style="{StaticResource StepCircleActiveStyle}">
                        <TextBlock Text="1" 
                                   Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Common_StepEmail}" 
                               Style="{StaticResource StepLabelActiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleActiveStyle}" Margin="12,0,0,0">
                        <TextBlock Text="2" 
                                   Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Common_StepVerify}" 
                               Style="{StaticResource StepLabelActiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleActiveStyle}" Margin="12,0,0,0">
                        <TextBlock Text="3" 
                                   Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Common_StepNewPassword}" 
                               Style="{StaticResource StepLabelActiveStyle}" 
                               Margin="8,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource HeaderIconBorderStyle}">
                    <TextBlock Text="🔒"
                               Style="{StaticResource HeaderEmojiStyle}" />
                </Border>

                <TextBlock Text="{DynamicResource NewPassword_Title}"
                           Style="{StaticResource CenteredTitleMediumTextStyle}" />

                <TextBlock Text="{DynamicResource NewPassword_Instructions}"
                           Style="{StaticResource CenteredSubtitleTextStyle}" />

                <TextBlock Text="{DynamicResource NewPassword_Label}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />

                <StackPanel>
                    <PasswordBox x:Name="pwdNewPassword"
                                 Style="{StaticResource FieldStyle}"
                                 PasswordChanged="PwdNewPassword_PasswordChanged" />
                    <TextBlock x:Name="lblPasswordError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <UniformGrid Rows="1" Columns="5" Margin="0,8,0,2">
                    <Border x:Name="brdStrength1" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="brdStrength2" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="brdStrength3" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="brdStrength4" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="brdStrength5" Style="{StaticResource StrengthBarStyle}" Margin="0" />
                </UniformGrid>

                <TextBlock x:Name="lblStrengthLabel"
                           Style="{StaticResource ErrorTextStyle}"
                           Margin="0,2,0,8" />

                <Border Style="{StaticResource HintPanelStyle}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource NewPassword_HintLength}" 
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintUppercase}" 
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintLowercase}" 
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintNumber}" 
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintSymbol}" 
                                   Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource NewPassword_ConfirmLabel}"
                           Style="{StaticResource FieldLabelTextStyle}" />

                <StackPanel>
                    <PasswordBox x:Name="pwdConfirmPassword"
                                 Style="{StaticResource FieldStyle}"
                                 PasswordChanged="PwdConfirmPassword_PasswordChanged" />
                    <TextBlock x:Name="lblMismatchError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <Button Content="{DynamicResource NewPassword_SetPasswordButton}"
                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                        Margin="0,20,0,12"
                        Command="{Binding SetPasswordCommand}" />

                <Button Content="{DynamicResource NewPassword_BackToForgotPasswordButton}"
                        Style="{StaticResource CenteredLinkButtonStyle}"
                        Command="{Binding BackCommand}" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</local:LocalizableScreen>