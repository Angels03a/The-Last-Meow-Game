                <Line X1="34" Y1="42" X2="46" Y2="56" Style="{StaticResource FugitiveKittenBackLegStyle}" />
                <Line X1="60" Y1="41" X2="52" Y2="56" Style="{StaticResource FugitiveKittenBackLegStyle}" />
                <Path Data="M22,30 Q6,34 2,22" Style="{StaticResource FugitiveKittenTailStyle}" />
                <Ellipse Canvas.Left="22" Canvas.Top="20" Width="48" Height="28"
                         Fill="{DynamicResource Brush_FugitiveKittenBody}" />
                <Ellipse Canvas.Left="33" Canvas.Top="35" Width="30" Height="10"
                         Fill="{DynamicResource Brush_FugitiveKittenCream}" Opacity="0.85" />
                <Line X1="30" Y1="41" X2="40" Y2="55" Style="{StaticResource FugitiveKittenFrontLegStyle}" />
                <Line X1="64" Y1="40" X2="58" Y2="56" Style="{StaticResource FugitiveKittenFrontLegStyle}" />
                <ContentControl Template="{StaticResource FugitiveKittenHeadTemplate}" Focusable="False" />
            </Canvas>
        </Canvas>
    </ControlTemplate>
    <Style x:Key="VerificationExpirationTextStyle" TargetType="TextBlock">
