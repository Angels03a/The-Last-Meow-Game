    <Style x:Key="LobbyToggleReadyButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ActionDangerOutlineButtonStyle}">
        <Setter Property="Content" Value="{DynamicResource Lobby_MarkReadyButton}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocalPlayerReady}" Value="True">
                <Setter Property="Content" Value="{DynamicResource Lobby_MarkNotReadyButton}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LobbyChatSenderTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocalSender}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush_Gold}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LobbyChatMessageTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
    </Style>

    <Style x:Key="LobbyGuestChatNoticeTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-20,0,0" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsGuestSession}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
