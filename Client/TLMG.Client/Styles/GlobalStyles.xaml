    <Style x:Key="GameplayHandCardItemButtonStyle" TargetType="Button"
       BasedOn="{StaticResource GameplayHandCardEgyptianButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Zombie">
                <Setter Property="Background" Value="{StaticResource Brush_OnlineSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush_OnlineBorder}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Skull">
                <Setter Property="Background" Value="{StaticResource Brush_AccentSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsCompactHand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     Value="True">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="68" />
                <Setter Property="Margin" Value="0,0,6,6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameplayHandCardItemEmojiStyle" TargetType="TextBlock"
       BasedOn="{StaticResource GameplayHandCardEmojiStyle}">
        <Setter Property="Text" Value="🎴" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Skull">
                <Setter Property="Text" Value="☠️" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsCompactHand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     Value="True">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameplayHandCardItemLabelStyle" TargetType="TextBlock"
       BasedOn="{StaticResource GameplayHandCardEgyptianLabelStyle}">
        <Setter Property="Text" Value="{DynamicResource Common_EgyptianCatLabel}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Zombie">
                <Setter Property="Text" Value="{DynamicResource Common_ZombieCatLabel}" />
                <Setter Property="Foreground" Value="{StaticResource Brush_Online}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Skull">
                <Setter Property="Text" Value="{DynamicResource Common_SkullCatLabel}" />
                <Setter Property="Foreground" Value="{StaticResource Brush_AccentLight}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsCompactHand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     Value="True">
                <Setter Property="FontSize" Value="8" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="MatchRecoveryBannerTemplate">
        <Border Background="{StaticResource Brush_BackgroundDark}" BorderBrush="{StaticResource Brush_Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,8" MaxWidth="650">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RecoveryMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding RecoveryMessage}" Foreground="{StaticResource Brush_TextPrimary}"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="14" />
                <Button Content="{DynamicResource Recovery_Retry}" Command="{Binding RetryRecoveryCommand}"
                        HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AuthenticationSecondaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanRetryRecovery}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>