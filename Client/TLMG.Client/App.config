<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<bindings>
			<netTcpBinding>

				<binding name="NetTcpBinding_IUsersManager"
						 closeTimeout="00:00:05"
						 openTimeout="00:00:10"
						 sendTimeout="00:00:15">
					<security>
						<transport sslProtocols="None" />
					</security>
				</binding>

				<binding name="NetTcpBinding_ILeaderboardManager"
						 closeTimeout="00:00:05"
						 openTimeout="00:00:10"
						 sendTimeout="00:00:15">
					<security>
						<transport sslProtocols="None" />
					</security>
				</binding>

				<binding name="NetTcpBinding_ILobbyManager"
						 closeTimeout="00:00:05"
						 openTimeout="00:00:10"
						 sendTimeout="00:00:15">
					<security>
						<transport sslProtocols="None" />
					</security>
				</binding>

				<binding name="NetTcpBinding_IFriendsManager"
						 closeTimeout="00:00:05"
						 openTimeout="00:00:10"
						 sendTimeout="00:00:15">
					<security>
						<transport sslProtocols="None" />
					</security>
				</binding>

				<binding name="NetTcpBinding_IChatManager"
						 closeTimeout="00:00:05"
						 openTimeout="00:00:10"
						 sendTimeout="00:00:15">
					<security>
						<transport sslProtocols="None" />
					</security>
				</binding>

			</netTcpBinding>
		</bindings>

		<client>

			<endpoint address="net.tcp://localhost:8081/AccountRegistrationService"
					  binding="netTcpBinding"
					  bindingConfiguration="NetTcpBinding_IUsersManager"
					  contract="UsersManagerReference.IUsersManager"
					  name="NetTcpBinding_IUsersManager" />

			<endpoint address="net.tcp://localhost:8081/LeaderboardManager"
					  binding="netTcpBinding"
					  bindingConfiguration="NetTcpBinding_ILeaderboardManager"
					  contract="UsersManagerReference.ILeaderboardManager"
					  name="NetTcpBinding_ILeaderboardManager" />

			<endpoint address="net.tcp://localhost:8081/LobbyManager"
					  binding="netTcpBinding"
					  bindingConfiguration="NetTcpBinding_ILobbyManager"
					  contract="UsersManagerReference.ILobbyManager"
					  name="NetTcpBinding_ILobbyManager" />

			<endpoint address="net.tcp://localhost:8081/FriendsManager"
					  binding="netTcpBinding"
					  bindingConfiguration="NetTcpBinding_IFriendsManager"
					  contract="UsersManagerReference.IFriendsManager"
					  name="NetTcpBinding_IFriendsManager" />

			<endpoint address="net.tcp://localhost:8081/ChatManager"
					  binding="netTcpBinding"
					  bindingConfiguration="NetTcpBinding_IChatManager"
					  contract="UsersManagerReference.IChatManager"
					  name="NetTcpBinding_IChatManager" />

		</client>
	</system.serviceModel>

</configuration>