<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="TLMG_DBEntities" connectionString="metadata=res://*/DatabaseModel.TLMGModel.csdl|res://*/DatabaseModel.TLMGModel.ssdl|res://*/DatabaseModel.TLMGModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost;initial catalog=TLMG_DB;integrated security=True;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  </connectionStrings>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <!-- Tiempos límite acotados: la interfaz no se bloquea hasta un minuto si el servidor no responde. -->
        <binding name="NetTcpBinding_IAccountRegistrationService"
          openTimeout="00:00:10" sendTimeout="00:00:15" closeTimeout="00:00:05">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8081/AccountRegistrationService"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IAccountRegistrationService"
        contract="AccountRegistrationServiceReference.IAccountRegistrationService"
        name="NetTcpBinding_IAccountRegistrationService">
        <identity>
          <userPrincipalName value="STELLARLOQ\armas" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>