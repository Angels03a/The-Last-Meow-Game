<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<bindings>
   <netTcpBinding>
    <binding name="NetTcpBinding_IUsersManager">
     <security>
      <transport sslProtocols="None" />
     </security>
    </binding>
    <binding name="NetTcpBinding_ILeaderboardManager">
     <security>
      <transport sslProtocols="None" />
     </security>
    </binding>
    <binding name="NetTcpBinding_ILobbyManager">
     <security>
      <transport sslProtocols="None" />
     </security>
    </binding>
    <binding name="NetTcpBinding_IFriendsManager">
     <security>
      <transport sslProtocols="None" />
     </security>
    </binding>
    <binding name="NetTcpBinding_IChatManager">
     <security>
      <transport sslProtocols="None" />
     </security>
    </binding>
   </netTcpBinding>
  </bindings>

		<client>
   <endpoint address="net.tcp://localhost:8081/AccountRegistrationService"
    binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IUsersManager"
    contract="UsersManagerReference.IUsersManager" name="NetTcpBinding_IUsersManager">
    <identity>
     <userPrincipalName value="STELLARLOQ\armas" />
    </identity>
   </endpoint>
   <endpoint address="net.tcp://localhost:8081/LeaderboardManager"
    binding="netTcpBinding" bindingConfiguration="NetTcpBinding_ILeaderboardManager"
    contract="UsersManagerReference.ILeaderboardManager" name="NetTcpBinding_ILeaderboardManager">
    <identity>
     <userPrincipalName value="STELLARLOQ\armas" />
    </identity>
   </endpoint>
   <endpoint address="net.tcp://localhost:8081/LobbyManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_ILobbyManager" contract="UsersManagerReference.ILobbyManager"
    name="NetTcpBinding_ILobbyManager">
    <identity>
     <userPrincipalName value="STELLARLOQ\armas" />
    </identity>
   </endpoint>
   <endpoint address="net.tcp://localhost:8081/FriendsManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IFriendsManager" contract="UsersManagerReference.IFriendsManager"
    name="NetTcpBinding_IFriendsManager">
    <identity>
     <userPrincipalName value="STELLARLOQ\armas" />
    </identity>
   </endpoint>
   <endpoint address="net.tcp://localhost:8081/ChatManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IChatManager" contract="UsersManagerReference.IChatManager"
    name="NetTcpBinding_IChatManager">
    <identity>
     <userPrincipalName value="STELLARLOQ\armas" />
    </identity>
   </endpoint>
  </client>
	</system.serviceModel>

</configuration>