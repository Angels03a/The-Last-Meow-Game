<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<system.serviceModel>
		<bindings>
   <netTcpBinding>
    <binding name="NetTcpBinding_IUsersManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
    <binding name="NetTcpBinding_ILeaderboardManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
    <binding name="NetTcpBinding_ILobbyManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
    <binding name="NetTcpBinding_IFriendsManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
    <binding name="NetTcpBinding_IChatManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
    <binding name="NetTcpBinding_IMatchManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
    <binding name="NetTcpBinding_IPasswordManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
    <binding name="NetTcpBinding_ISessionManager" closeTimeout="00:00:05"
     openTimeout="00:00:10" sendTimeout="00:00:15">
     <security mode="None" />
    </binding>
   </netTcpBinding>
  </bindings>

		<client>
   <endpoint address="net.tcp://localhost:8081/AccountRegistrationService"
    binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IUsersManager"
    contract="UsersManagerReference.IUsersManager" name="NetTcpBinding_IUsersManager" />
   <endpoint address="net.tcp://localhost:8081/LeaderboardManager"
    binding="netTcpBinding" bindingConfiguration="NetTcpBinding_ILeaderboardManager"
    contract="UsersManagerReference.ILeaderboardManager" name="NetTcpBinding_ILeaderboardManager" />
   <endpoint address="net.tcp://localhost:8081/LobbyManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_ILobbyManager" contract="UsersManagerReference.ILobbyManager"
    name="NetTcpBinding_ILobbyManager" />
   <endpoint address="net.tcp://localhost:8081/FriendsManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IFriendsManager" contract="UsersManagerReference.IFriendsManager"
    name="NetTcpBinding_IFriendsManager" />
   <endpoint address="net.tcp://localhost:8081/ChatManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IChatManager" contract="UsersManagerReference.IChatManager"
    name="NetTcpBinding_IChatManager" />
   <endpoint address="net.tcp://localhost:8081/MatchManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IMatchManager" contract="UsersManagerReference.IMatchManager"
    name="NetTcpBinding_IMatchManager" />
   <endpoint address="net.tcp://localhost:8081/PasswordManager"
    binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IPasswordManager"
    contract="UsersManagerReference.IPasswordManager" name="NetTcpBinding_IPasswordManager" />
   <endpoint address="net.tcp://localhost:8081/SessionManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_ISessionManager" contract="UsersManagerReference.ISessionManager"
    name="NetTcpBinding_ISessionManager" />
  </client>
	</system.serviceModel>
</configuration>