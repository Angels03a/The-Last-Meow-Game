<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="Color_BackgroundDark">#0D0D12</Color>
    <Color x:Key="Color_BackgroundDeep">#0D0D18</Color>
    <Color x:Key="Color_BackgroundPanel">#1A1A24</Color>
    <Color x:Key="Color_Border">#2E2E4A</Color>
    <Color x:Key="Color_BorderHover">#45456B</Color>
    <Color x:Key="Color_TextPrimary">#E8E6F0</Color>
    <Color x:Key="Color_TextMuted">#8880A8</Color>
    <Color x:Key="Color_TextFaint">#5A5670</Color>
    <Color x:Key="Color_Accent">#8B5CF6</Color>
    <Color x:Key="Color_AccentDark">#6D28D9</Color>
    <Color x:Key="Color_AccentHover">#7C3AED</Color>
    <Color x:Key="Color_AccentLight">#A78BFA</Color>
    <Color x:Key="Color_AccentSoft">#338B5CF6</Color>
    <Color x:Key="Color_LilacLight">#D8CCFB</Color>
    <Color x:Key="Color_SurfaceHover">#24243A</Color>
    <Color x:Key="Color_Error">#EF4444</Color>
    <Color x:Key="Color_White">#FFFFFF</Color>
    <Color x:Key="Color_Online">#10B981</Color>
    <Color x:Key="Color_Gold">#F59E0B</Color>

    <SolidColorBrush x:Key="Brush_BackgroundDark" Color="{StaticResource Color_BackgroundDark}" />
    <SolidColorBrush x:Key="Brush_BackgroundDeep" Color="{StaticResource Color_BackgroundDeep}" />
    <SolidColorBrush x:Key="Brush_BackgroundPanel" Color="{StaticResource Color_BackgroundPanel}" />
    <SolidColorBrush x:Key="Brush_Border" Color="{StaticResource Color_Border}" />
    <SolidColorBrush x:Key="Brush_BorderHover" Color="{StaticResource Color_BorderHover}" />
    <SolidColorBrush x:Key="Brush_TextPrimary" Color="{StaticResource Color_TextPrimary}" />
    <SolidColorBrush x:Key="Brush_TextMuted" Color="{StaticResource Color_TextMuted}" />
    <SolidColorBrush x:Key="Brush_TextFaint" Color="{StaticResource Color_TextFaint}" />
    <SolidColorBrush x:Key="Brush_Accent" Color="{StaticResource Color_Accent}" />
    <SolidColorBrush x:Key="Brush_AccentDark" Color="{StaticResource Color_AccentDark}" />
    <SolidColorBrush x:Key="Brush_AccentHover" Color="{StaticResource Color_AccentHover}" />
    <SolidColorBrush x:Key="Brush_AccentLight" Color="{StaticResource Color_AccentLight}" />
    <SolidColorBrush x:Key="Brush_AccentSoft" Color="{StaticResource Color_AccentSoft}" />
    <SolidColorBrush x:Key="Brush_LilacLight" Color="{StaticResource Color_LilacLight}" />
    <SolidColorBrush x:Key="Brush_SurfaceHover" Color="{StaticResource Color_SurfaceHover}" />
    <SolidColorBrush x:Key="Brush_Error" Color="{StaticResource Color_Error}" />
    <SolidColorBrush x:Key="Brush_White" Color="{StaticResource Color_White}" />
    <SolidColorBrush x:Key="Brush_Online" Color="{StaticResource Color_Online}" />
    <SolidColorBrush x:Key="Brush_Gold" Color="{StaticResource Color_Gold}" />

    <LinearGradientBrush x:Key="Brush_ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Color_AccentDark}" Offset="0" />
        <GradientStop Color="{StaticResource Color_Accent}" Offset="0.5" />
        <GradientStop Color="{StaticResource Color_AccentLight}" Offset="1" />
    </LinearGradientBrush>

    <ControlTemplate x:Key="CatIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="110" Height="110">
                <Ellipse Canvas.Left="10" Canvas.Top="23" Width="90" Height="78" Fill="{StaticResource Brush_Accent}" />
                <Polygon Points="14,32 32,32 18,4" Fill="{StaticResource Brush_Accent}" />
                <Polygon Points="78,32 96,32 92,4" Fill="{StaticResource Brush_Accent}" />
                <Ellipse Canvas.Left="32" Canvas.Top="50" Width="9" Height="12" Fill="{StaticResource Brush_BackgroundDark}" />
                <Ellipse Canvas.Left="69" Canvas.Top="50" Width="9" Height="12" Fill="{StaticResource Brush_BackgroundDark}" />
                <Polygon Points="50,68 60,68 55,74" Fill="{StaticResource Brush_BackgroundDark}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <Style x:Key="CatIconStyle" TargetType="ContentControl">
        <Setter Property="Template" Value="{StaticResource CatIconTemplate}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeaderIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Background" Value="{StaticResource Brush_Border}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="StepCircleActiveStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{StaticResource Brush_Accent}" />
    </Style>

    <Style x:Key="StepCircleInactiveStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{StaticResource Brush_Border}" />
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>

    <Style x:Key="StepNumberActiveStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush_White}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StepNumberInactiveStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StepLabelActiveStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,12,0" />
    </Style>

    <Style x:Key="StepLabelInactiveStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,12,0" />
    </Style>

    <Style x:Key="StepSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{StaticResource Brush_Border}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="brdButton" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush_Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush_White}" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush_AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="42" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush_BorderHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="16,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_SurfaceHover}" />
                <Setter Property="Foreground" Value="{StaticResource Brush_AccentLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MenuButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource Brush_Error}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#26EF4444" />
                <Setter Property="Foreground" Value="{StaticResource Brush_Error}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="brdButton" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush_White}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabButtonInactiveStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush_AccentLight}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush_BorderHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LangButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="LangButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource LangButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Brush_AccentSoft}" />
        <Setter Property="Foreground" Value="{StaticResource Brush_White}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}" />
    </Style>

    <Style x:Key="LangButtonInactiveStyle" TargetType="Button" BasedOn="{StaticResource LangButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush_BorderHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}" />
        <Setter Property="Padding" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush_AccentLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ForgotPasswordLinkStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush_LilacLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Border" Width="44" Height="24" CornerRadius="12" Background="{StaticResource Brush_Border}">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{StaticResource Brush_White}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush_Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CustomSliderStyle" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border x:Name="brdTrack" Background="Transparent" Height="24">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="{StaticResource Brush_Accent}" CornerRadius="3,0,0,3" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="{StaticResource Brush_Border}" CornerRadius="0,3,3,3" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="thmVolume" Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Brush_White}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldStyle" TargetType="Control">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="{StaticResource Brush_BackgroundDark}" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="VerificationDigitStyle" TargetType="TextBox">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxLength" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush_BackgroundDark}" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AttemptDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Fill" Value="{StaticResource Brush_Border}" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}" />
    </Style>

    <Style x:Key="TitleMediumTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="TitleLargeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextStyle}">
        <Setter Property="FontSize" Value="42" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}" />
    </Style>

    <Style x:Key="SubtitleLargeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextStyle}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Brush_Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Visibility" Value="Hidden" />
    </Style>

    <Style x:Key="FormMessageTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="Visibility" Value="Hidden" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextFaint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush_TextFaint}" />
    </Style>

    <Style x:Key="ProgressTrackStyle" TargetType="Border">
        <Setter Property="Width" Value="400" />
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource Brush_BackgroundPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ProgressFillStyle" TargetType="Rectangle">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="RadiusX" Value="8" />
        <Setter Property="RadiusY" Value="8" />
        <Setter Property="Fill" Value="{StaticResource Brush_ProgressGradient}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush_BackgroundPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="48,40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OptionsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush_BackgroundPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush_BackgroundPanel}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="StrengthBarStyle" TargetType="Border">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{StaticResource Brush_Border}" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="StrengthIndicatorStyle" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="5" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Style="{StaticResource StrengthBarStyle}" Background="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HintPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush_BackgroundDeep}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HeroBackgroundGlowStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="500" />
        <Setter Property="Height" Value="500" />
        <Setter Property="Opacity" Value="0.15" />
        <Setter Property="Fill">
            <Setter.Value>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource Color_Accent}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

