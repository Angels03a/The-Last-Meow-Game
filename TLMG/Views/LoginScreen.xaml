<UserControl x:Class="TLMG.Views.LoginScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource Brush_BackgroundDark}">
            <Ellipse Width="500" Height="500" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource Color_Accent}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl Style="{StaticResource CatIconStyle}" Width="110" Height="110" Margin="0,0,0,20" />
                <TextBlock Text="{DynamicResource Login_Title}"
                           Style="{StaticResource TitleTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />
                <TextBlock Text="{DynamicResource Login_Subtitle}"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource Brush_BackgroundPanel}" BorderBrush="{StaticResource Brush_Border}" BorderThickness="1,0,0,0">
            <StackPanel Margin="48,60,48,0">
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnTabLogIn"
                            Grid.Column="0"
                            Content="{DynamicResource Login_TabLogIn}"
                            Style="{StaticResource TabButtonActiveStyle}" />
                    <Button x:Name="btnTabCreateAccount"
                            Grid.Column="1"
                            Content="{DynamicResource Login_TabCreateAccount}"
                            Style="{StaticResource TabButtonInactiveStyle}"
                            Click="BtnTabCreateAccount_Click" />
                </Grid>

                <TextBlock Text="{DynamicResource Login_EmailLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtEmail"
                         Style="{StaticResource FieldStyle}" />
                <TextBlock x:Name="lblEmailError"
                           Style="{StaticResource ErrorTextStyle}" />

                <TextBlock Text="{DynamicResource Login_PasswordLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,16,0,6" />
                <Grid>
                    <PasswordBox x:Name="pwdPassword"
                                 Style="{StaticResource FieldStyle}" />
                    <TextBox x:Name="txtPasswordVisible"
                             Style="{StaticResource FieldStyle}"
                             Visibility="Collapsed" />
                    <Button x:Name="btnShowPassword"
                            Content="o"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Click="BtnShowPassword_Click" />
                </Grid>
                <TextBlock x:Name="lblPasswordError"
                           Style="{StaticResource ErrorTextStyle}" />

                <Button x:Name="btnForgotPassword"
                        Content="{DynamicResource Login_ForgotPassword}"
                        Style="{StaticResource ForgotPasswordLinkStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Click="BtnForgotPassword_Click" />

                <Button x:Name="btnLogIn"
                        Content="{DynamicResource Login_LogInButton}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,20,0,0"
                        Click="BtnLogIn_Click" />

                <Button x:Name="btnPlayAsGuest"
                        Content="{DynamicResource Login_GuestButton}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,10,0,0"
                        Click="BtnPlayAsGuest_Click" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>