<local:LocalizableScreen x:Class="TLMG.Views.LoginScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource Brush_BackgroundDark}">
            <Ellipse Style="{StaticResource HeroBackgroundGlowStyle}" />

            <StackPanel Style="{StaticResource HeroContentPanelStyle}">
                <StackPanel Style="{StaticResource HeroEmojiRowStyle}">
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🐱" Style="{StaticResource HeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🧟" Style="{StaticResource HeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🚀" Style="{StaticResource HeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="💀" Style="{StaticResource HeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🐈‍" Style="{StaticResource HeroEmojiStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🧛‍♀" Style="{StaticResource HeroEmojiStyle}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{DynamicResource Login_Title}" Style="{StaticResource HeroTitleTextStyle}" />
                <TextBlock Text="{DynamicResource Login_Subtitle}" Style="{StaticResource HeroSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource SidePanelBorderStyle}">
            <StackPanel Style="{StaticResource SidePanelContentStyle}">
                <Grid Style="{StaticResource AuthenticationTabsGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnTabLogIn"
                            Grid.Column="0"
                            Content="{DynamicResource Login_TabLogIn}"
                            Style="{StaticResource TabButtonActiveStyle}" />
                    <Button x:Name="btnTabCreateAccount"
                            Grid.Column="1"
                            Content="{DynamicResource Login_TabCreateAccount}"
                            Style="{StaticResource TabButtonInactiveStyle}"
                            Click="BtnTabCreateAccount_Click" />
                </Grid>

                <TextBlock Text="{DynamicResource Login_EmailLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtEmail"
                         Style="{StaticResource FieldStyle}" />
                <TextBlock x:Name="lblEmailError"
                           Style="{StaticResource ErrorTextStyle}" />

                <TextBlock Text="{DynamicResource Login_PasswordLabel}"
                           Style="{StaticResource FieldLabelTextStyle}" />
                <Grid>
                    <PasswordBox x:Name="pwdPassword"
                                 Style="{StaticResource FieldStyle}" />
                    <TextBox x:Name="txtPasswordVisible"
                             Style="{StaticResource FieldStyle}"
                             Visibility="Collapsed" />
                    <Button x:Name="btnShowPassword"
                            Content="●"
                            Style="{StaticResource PasswordToggleButtonStyle}"
                            ToolTip="{DynamicResource Login_ShowPasswordHint}"
                            Click="BtnShowPassword_Click" />
                </Grid>
                <TextBlock x:Name="lblPasswordError"
                           Style="{StaticResource ErrorTextStyle}" />

                <Button x:Name="btnForgotPassword"
                        Style="{StaticResource RightAlignedLinkButtonStyle}"
                        Click="BtnForgotPassword_Click">
                    <TextBlock Text="{DynamicResource Login_ForgotPassword}" TextDecorations="Underline" />
                </Button>

                <Button x:Name="btnLogIn"
                        Content="{DynamicResource Login_LogInButton}"
                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                        Click="BtnLogIn_Click" />

                <Button x:Name="btnPlayAsGuest"
                        Content="{DynamicResource Login_GuestButton}"
                        Style="{StaticResource AuthenticationSecondaryButtonStyle}"
                        Click="BtnPlayAsGuest_Click" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</local:LocalizableScreen>