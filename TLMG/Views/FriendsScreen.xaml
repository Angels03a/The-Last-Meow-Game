<local:LocalizableScreen x:Class="TLMG.Views.FriendsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SidePanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="{DynamicResource Friends_SidebarTitle}" 
                           Style="{StaticResource SidebarTitleTextStyle}" />

                <Button Grid.Row="2" 
                        x:Name="btnBack"
                        Content="{DynamicResource Profile_BackButton}"
                        Style="{StaticResource SidebarBackButtonStyle}"
                        Click="BtnBack_Click" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="40,32,40,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" 
                         Grid.Column="0" 
                         Style="{StaticResource SearchFieldStyle}" 
                         Tag="{DynamicResource Friends_SearchPlaceholder}" />

                <Button x:Name="btnAddFriend" 
                        Grid.Column="2" 
                        Content="{DynamicResource Friends_AddFriendButton}" 
                        Style="{StaticResource AddFriendButtonStyle}" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,0,0,1" Margin="40,0,40,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnTabFriends" 
                            Style="{StaticResource TabNavActiveButtonStyle}" 
                            Click="BtnBack_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabFriends}" 
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgeFriends" Style="{StaticResource BadgeActiveStyle}">
                                <TextBlock x:Name="lblBadgeFriends" 
                                           Text="5" 
                                           Style="{StaticResource BadgeTextActiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnTabPending" Style="{StaticResource TabNavInactiveButtonStyle}" Click="BtnTab_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabPending}" 
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgePending" Style="{StaticResource BadgeInactiveStyle}">
                                <TextBlock x:Name="lblBadgePending" 
                                           Text="2" 
                                           Style="{StaticResource BadgeTextInactiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnTabBlocked" Style="{StaticResource TabNavInactiveButtonStyle}" Click="BtnTab_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Friends_TabBlocked}" 
                                       VerticalAlignment="Center" />
                            <Border x:Name="brdBadgeBlocked" Style="{StaticResource BadgeInactiveStyle}">
                                <TextBlock x:Name="lblBadgeBlocked" 
                                           Text="1" 
                                           Style="{StaticResource BadgeTextInactiveStyle}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="40,24,40,24">
                <Grid>
                    <StackPanel x:Name="grdFriendsContent" Visibility="Visible">
                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <Border Style="{StaticResource FriendAvatarBorderStyle}">
                                        <TextBlock Text="🐯" 
                                                   Style="{StaticResource FriendAvatarEmojiStyle}" />
                                    </Border>
                                    <Ellipse Style="{StaticResource StatusDotOnlineStyle}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="NyanProwler" 
                                               Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_StatusOnline}" 
                                               Style="{StaticResource StatusTextOnlineStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource ScoreContainerStyle}">
                                    <TextBlock Text="⭐" 
                                               Style="{StaticResource ScoreStarStyle}" />
                                    <TextBlock Text="1920" 
                                               Style="{StaticResource ScoreValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_BtnInvite}" 
                                            Style="{StaticResource ActionPrimarySmallButtonStyle}" />
                                    <Button Content="{DynamicResource Friends_BtnBlock}" 
                                            Style="{StaticResource ActionDangerOutlineButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <Border Style="{StaticResource FriendAvatarBorderStyle}">
                                        <TextBlock Text="🐱" 
                                                   Style="{StaticResource FriendAvatarEmojiStyle}" />
                                    </Border>
                                    <Ellipse Style="{StaticResource StatusDotInGameStyle}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CatNapper9000" 
                                               Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_StatusInGame}" 
                                               Style="{StaticResource StatusTextInGameStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource ScoreContainerStyle}">
                                    <TextBlock Text="⭐" 
                                               Style="{StaticResource ScoreStarStyle}" />
                                    <TextBlock Text="1750" 
                                               Style="{StaticResource ScoreValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_BtnInvite}" 
                                            Style="{StaticResource ActionPrimarySmallButtonStyle}" />
                                    <Button Content="{DynamicResource Friends_BtnBlock}" 
                                            Style="{StaticResource ActionDangerOutlineButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <Border Style="{StaticResource FriendAvatarBorderStyle}">
                                        <TextBlock Text="🧟" 
                                                   Style="{StaticResource FriendAvatarEmojiStyle}" />
                                    </Border>
                                    <Ellipse Style="{StaticResource StatusDotOnlineStyle}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MeowMaster" 
                                               Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_StatusOnline}" 
                                               Style="{StaticResource StatusTextOnlineStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource ScoreContainerStyle}">
                                    <TextBlock Text="⭐" 
                                               Style="{StaticResource ScoreStarStyle}" />
                                    <TextBlock Text="2100" 
                                               Style="{StaticResource ScoreValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_BtnInvite}" 
                                            Style="{StaticResource ActionPrimarySmallButtonStyle}" />
                                    <Button Content="{DynamicResource Friends_BtnBlock}" 
                                            Style="{StaticResource ActionDangerOutlineButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <Border Style="{StaticResource FriendAvatarBorderStyle}">
                                        <TextBlock Text="💀" 
                                                   Style="{StaticResource FriendAvatarEmojiStyle}" />
                                    </Border>
                                    <Ellipse Style="{StaticResource StatusDotOfflineStyle}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PurrfectStorm" 
                                               Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_StatusOffline}" 
                                               Style="{StaticResource StatusTextOfflineStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Style="{StaticResource ScoreContainerStyle}">
                                    <TextBlock Text="⭐" 
                                               Style="{StaticResource ScoreStarStyle}" />
                                    <TextBlock Text="1600" 
                                               Style="{StaticResource ScoreValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_BtnInvite}" 
                                            Style="{StaticResource ActionGhostSmallButtonStyle}" 
                                            IsEnabled="False" 
                                            Opacity="0.5" />
                                    <Button Content="{DynamicResource Friends_BtnBlock}" 
                                            Style="{StaticResource ActionDangerOutlineButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="lblEmptyFriends" 
                               Text="{DynamicResource Friends_EmptyFriends}" 
                               Style="{StaticResource EmptyStateTextStyle}" 
                               Visibility="Collapsed" />

                    <StackPanel x:Name="grdPendingContent" Visibility="Collapsed">
                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0">
                                    <TextBlock Text="🚀" 
                                               Style="{StaticResource FriendAvatarEmojiStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="AstroKitty" 
                                               Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_PendingIncoming}" 
                                               Style="{StaticResource StatusTextOfflineStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_BtnAccept}" 
                                            Style="{StaticResource ActionSuccessButtonStyle}" />
                                    <Button Content="{DynamicResource Friends_BtnDecline}" 
                                            Style="{StaticResource ActionDangerButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0">
                                    <TextBlock Text="🐱" 
                                               Style="{StaticResource FriendAvatarEmojiStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SchroBinger" 
                                               Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_PendingOutgoing}" 
                                               Style="{StaticResource StatusTextOfflineStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_BtnCancel}" 
                                            Style="{StaticResource ActionGhostSmallButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="lblEmptyPending" 
                               Text="{DynamicResource Friends_EmptyPending}" 
                               Style="{StaticResource EmptyStateTextStyle}" 
                               Visibility="Collapsed" />

                    <StackPanel x:Name="grdBlockedContent" Visibility="Collapsed">
                        <Border Style="{StaticResource FriendCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}" Margin="0,0,16,0" Background="{StaticResource Brush_BackgroundDark}">
                                    <TextBlock Text="🐱" 
                                               Style="{StaticResource FriendAvatarEmojiStyle}" 
                                               Opacity="0.5" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ToxicTabby" 
                                               Style="{StaticResource FriendNameTextStyle}" />
                                    <TextBlock Text="{DynamicResource Friends_BlockedReason}" 
                                               Style="{StaticResource StatusTextDangerStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Friends_BtnUnblock}" 
                                            Style="{StaticResource ActionGhostSmallButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="lblEmptyBlocked" 
                               Text="{DynamicResource Friends_EmptyBlocked}" 
                               Style="{StaticResource EmptyStateTextStyle}" 
                               Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:LocalizableScreen>