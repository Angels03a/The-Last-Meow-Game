<local:LocalizableScreen x:Class="TLMG.Views.LobbyScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">

        <Grid x:Name="grdKickModal" Visibility="Collapsed" Background="#D8000000" Panel.ZIndex="100">
            <Border Style="{StaticResource ModalBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🗳️" 
                               FontSize="48" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,16" 
                               FontFamily="Segoe UI Emoji" 
                               Foreground="{StaticResource Brush_TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Lobby_KickModalTitle}" 
                               Style="{StaticResource TitleMediumTextStyle}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,16"/>
                    <TextBlock Text="{DynamicResource Lobby_KickModalDesc}" 
                               Style="{StaticResource SubtitleTextStyle}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,32" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnCancelKick" 
                                Grid.Column="0" 
                                Content="{DynamicResource Lobby_MenuCancel}" 
                                Style="{StaticResource OutlineButtonStyle}" 
                                Click="BtnCancelKick_Click" />
                        <Button x:Name="btnConfirmKick" 
                                Grid.Column="2" 
                                Content="{DynamicResource Lobby_MenuKick}" 
                                Style="{StaticResource ActionDangerButtonStyle}" 
                                Height="42" 
                                Click="BtnConfirmKick_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="brdToast" Visibility="Collapsed" Style="{StaticResource ToastBorderStyle}" Panel.ZIndex="101">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📄" 
                           Margin="0,0,12,0" 
                           VerticalAlignment="Center" 
                           FontFamily="Segoe UI Emoji" 
                           Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock Text="{DynamicResource Lobby_KickToastMsg}" 
                           Style="{StaticResource StatusTextOnlineStyle}" 
                           Foreground="{StaticResource Brush_White}" 
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid x:Name="grdCountdown" Visibility="Collapsed" Background="#E60D0D12" Panel.ZIndex="90">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Lobby_CountdownTitle}" 
                           Style="{StaticResource TitleMediumTextStyle}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,16" 
                           Foreground="{StaticResource Brush_Gold}"/>
                <TextBlock x:Name="lblCountdownTimer" 
                           Text="3" 
                           FontSize="120" 
                           FontWeight="Black" 
                           Foreground="{StaticResource Brush_White}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,48"/>
                <Button x:Name="btnCancelCountdown" 
                        Content="{DynamicResource Lobby_CancelCountdown}" 
                        Style="{StaticResource ActionDangerOutlineButtonStyle}" 
                        Width="200" 
                        Height="48" 
                        FontSize="16" 
                        Click="BtnCancelCountdown_Click" />
            </StackPanel>
        </Grid>

        <Popup x:Name="popPlayerOptions" 
               StaysOpen="False" 
               Placement="MousePoint" 
               AllowsTransparency="True">
            <Border Style="{StaticResource ContextMenuBorderStyle}">
                <StackPanel>
                    <TextBlock Text="NYANPROWLER" 
                               Style="{StaticResource ContextMenuHeaderStyle}" />
                    <Button x:Name="btnMenuKick" 
                            Content="{DynamicResource Lobby_MenuKick}" 
                            Style="{StaticResource ContextMenuItemStyle}" 
                            Click="BtnMenuKick_Click" />
                    <Button x:Name="btnMenuReport" 
                            Content="{DynamicResource Lobby_MenuReport}" 
                            Style="{StaticResource ContextMenuItemStyle}" />
                    <Button x:Name="btnMenuBlock" 
                            Content="{DynamicResource Lobby_MenuBlock}" 
                            Style="{StaticResource ContextMenuDangerItemStyle}" />
                    <Button x:Name="btnMenuCancel" 
                            Content="{DynamicResource Lobby_MenuCancel}" 
                            Style="{StaticResource ContextMenuItemStyle}" 
                            Click="BtnMenuCancel_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SidePanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,24,32">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource FriendAvatarBorderStyle}">
                                <TextBlock Text="🐱" 
                                           Style="{StaticResource FriendAvatarEmojiStyle}" 
                                           FontFamily="Segoe UI Emoji" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="WhiskerKnight" 
                                           Style="{StaticResource FriendNameTextStyle}" />
                                <TextBlock Text="{DynamicResource Lobby_RoomCreator}" 
                                           Style="{StaticResource StatusTextOfflineStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="142" 
                                           Style="{StaticResource ProfileStatValueStyle}" 
                                           Foreground="{StaticResource Brush_Gold}"/>
                                <TextBlock Text="{DynamicResource Profile_Wins}" 
                                           Style="{StaticResource StatCardLabelStyle}" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="#38" 
                                           Style="{StaticResource ProfileStatValueStyle}" 
                                           Foreground="{StaticResource Brush_LilacLight}"/>
                                <TextBlock Text="{DynamicResource Profile_Rank}" 
                                           Style="{StaticResource StatCardLabelStyle}" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="btnInviteFriends" 
                                Content="{DynamicResource Lobby_InviteFriends}" 
                                Style="{StaticResource ActionGhostSmallButtonStyle}" 
                                Margin="0,0,0,16" 
                                Click="BtnInviteFriends_Click" />
                    </StackPanel>

                    <Button Grid.Row="2" 
                            x:Name="btnLeaveLobby"
                            Content="{DynamicResource Lobby_LeaveLobby}"
                            Style="{StaticResource ActionDangerButtonStyle}"
                            Height="48"
                            Margin="24,24,24,32"
                            Click="BtnLeaveLobby_Click" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="grdMainCenter">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="40,32,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Lobby_MainTitle}" 
                                   Style="{StaticResource TitleMediumTextStyle}" 
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Lobby_RoomInformation}" 
                                   Style="{StaticResource SubtitleTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Lobby_CardsPerPlayer}" 
                                   Style="{StaticResource StatCardLabelStyle}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,16,0" />
                        <ComboBox x:Name="cmbGameMode" 
                                  Width="280" 
                                  Style="{StaticResource DarkComboBoxStyle}" 
                                  SelectionChanged="CmbGameMode_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Lobby_GameMode4Cards}" IsSelected="True" />
                            <ComboBoxItem Content="{DynamicResource Lobby_GameMode6Cards}" />
                            <ComboBoxItem Content="{DynamicResource Lobby_GameMode8Cards}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="0" BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,0,0,1" Margin="40,32,40,0" VerticalAlignment="Bottom" />

                <UniformGrid Grid.Row="1" Rows="2" Columns="3" Margin="80,48,80,48">
                    <Border x:Name="brdPlayer1" Style="{StaticResource LobbyCardNotReadyStyle}" MouseLeftButtonDown="BrdPlayer1_MouseLeftButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource FriendAvatarBorderStyle}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🐱" 
                                           Style="{StaticResource FriendAvatarEmojiStyle}" 
                                           FontFamily="Segoe UI Emoji" />
                            </Border>
                            <TextBlock Text="WhiskerKnight" 
                                       Style="{StaticResource FriendNameTextStyle}" 
                                       HorizontalAlignment="Center" />
                            <Border Style="{StaticResource RoleBadgeStyle}" Margin="0,8,0,16">
                                <TextBlock Text="{DynamicResource Lobby_RoleCreator}" 
                                           Style="{StaticResource BadgeTextInactiveStyle}" />
                            </Border>
                            <Border x:Name="brdStatus1" Style="{StaticResource StatusBadgeNotReadyStyle}">
                                <TextBlock x:Name="lblStatus1" 
                                           Text="{DynamicResource Lobby_StatusNotReady}" 
                                           Style="{StaticResource StatusTextNotReadyStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="brdPlayer2" Style="{StaticResource LobbyCardReadyStyle}" MouseLeftButtonDown="BrdPlayer2_MouseLeftButtonDown" MouseRightButtonDown="BrdPlayer_MouseRightButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource FriendAvatarBorderStyle}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🐯" 
                                           Style="{StaticResource FriendAvatarEmojiStyle}" 
                                           FontFamily="Segoe UI Emoji" />
                            </Border>
                            <TextBlock Text="NyanProwler" 
                                       Style="{StaticResource FriendNameTextStyle}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,40" />
                            <Border x:Name="brdStatus2" Style="{StaticResource StatusBadgeReadyStyle}">
                                <TextBlock x:Name="lblStatus2" 
                                           Text="{DynamicResource Lobby_StatusReady}" 
                                           Style="{StaticResource StatusTextReadyStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="brdPlayer3" Style="{StaticResource LobbyCardNotReadyStyle}" MouseLeftButtonDown="BrdPlayer3_MouseLeftButtonDown" MouseRightButtonDown="BrdPlayer_MouseRightButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource FriendAvatarBorderStyle}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🐱" Style="{StaticResource FriendAvatarEmojiStyle}" FontFamily="Segoe UI Emoji" />
                            </Border>
                            <TextBlock Text="CatNapper9000" 
                                       Style="{StaticResource FriendNameTextStyle}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,40"/>
                            <Border x:Name="brdStatus3" Style="{StaticResource StatusBadgeNotReadyStyle}">
                                <TextBlock x:Name="lblStatus3" 
                                           Text="{DynamicResource Lobby_StatusNotReady}" 
                                           Style="{StaticResource StatusTextNotReadyStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LobbyCardEmptyStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="+" 
                                       FontSize="24" 
                                       Foreground="{StaticResource Brush_TextFaint}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,16" />
                            <TextBlock Text="{DynamicResource Lobby_Waiting}" 
                                       Style="{StaticResource StatusTextOfflineStyle}" 
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LobbyCardEmptyStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="+" 
                                       FontSize="24" 
                                       Foreground="{StaticResource Brush_TextFaint}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,16" />
                            <TextBlock Text="{DynamicResource Lobby_Waiting}" 
                                       Style="{StaticResource StatusTextOfflineStyle}" 
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LobbyCardEmptyStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="+" 
                                       FontSize="24" 
                                       Foreground="{StaticResource Brush_TextFaint}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,16" />
                            <TextBlock Text="{DynamicResource Lobby_Waiting}" 
                                       Style="{StaticResource StatusTextOfflineStyle}" 
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,0,0,1" Margin="40,0,40,0" VerticalAlignment="Bottom" />

                <Grid Grid.Row="2" Margin="40,16,40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="scrChat" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel x:Name="pnlChatMessages">
                            <TextBlock Margin="0,0,0,8">
                                <Run Text="NyanProwler: " 
                                     Foreground="{StaticResource Brush_Gold}" 
                                     FontWeight="Bold" />
                                <Run Text="{DynamicResource Lobby_MockChatPlayer}" 
                                     Foreground="{StaticResource Brush_TextPrimary}" />
                            </TextBlock>
                            <TextBlock Margin="0,0,0,8">
                                <Run Text="{DynamicResource Lobby_ChatSystemPrefix}" 
                                     Foreground="{StaticResource Brush_TextFaint}" 
                                     FontWeight="Bold" />
                                <Run Text="{DynamicResource Lobby_SystemJoinedMsg}" 
                                     Foreground="{StaticResource Brush_TextFaint}" />
                            </TextBlock>
                            <TextBlock Margin="0,0,0,8">
                                <Run Text="{DynamicResource Lobby_ChatSystemPrefix}" 
                                     Foreground="{StaticResource Brush_TextFaint}" 
                                     FontWeight="Bold" />
                                <Run Text="{DynamicResource Lobby_SystemReadyMsg}" 
                                     Foreground="{StaticResource Brush_TextFaint}" />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChatInput" 
                                 Grid.Column="0" 
                                 Style="{StaticResource FieldStyle}" 
                                 Height="42" 
                                 Tag="{DynamicResource Lobby_ChatPlaceholder}" 
                                 KeyDown="TxtChatInput_KeyDown" />
                        <Button x:Name="btnSendChat" 
                                Grid.Column="2" 
                                Content="{DynamicResource Lobby_ChatSend}" 
                                Style="{StaticResource ActionPrimarySmallButtonStyle}" 
                                Width="80" 
                                Height="42" 
                                Margin="0" 
                                Click="BtnSendChat_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource SidePanelRightBorderStyle}">
                <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="{DynamicResource Lobby_PlayersReadyTitle}" 
                               Style="{StaticResource StatCardLabelStyle}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,16" />
                    <TextBlock x:Name="lblReadyFraction" 
                               Text="1/3" 
                               FontSize="48" 
                               FontWeight="Black" 
                               Foreground="{StaticResource Brush_Gold}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,24" />
                    <TextBlock Text="{DynamicResource Lobby_ReadyHelperText}" 
                               Style="{StaticResource StatusTextOfflineStyle}" 
                               TextAlignment="Center" 
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</local:LocalizableScreen>