<UserControl x:Class="TLMG.Views.VerificationScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Border Style="{StaticResource HeaderIconBorderStyle}">
                    <TextBlock Text="&#9993;"
                               FontSize="28"
                               Foreground="{StaticResource Brush_Accent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{DynamicResource Verification_Title}"
                           Style="{StaticResource TitleMediumTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource Verification_Instructions}"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                    <TextBox x:Name="txtDigit1" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit2" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit3" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit4" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit5" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit6" Style="{StaticResource VerificationDigitStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                    <Ellipse x:Name="elpAttempt1" Style="{StaticResource AttemptDotStyle}" />
                    <Ellipse x:Name="elpAttempt2" Style="{StaticResource AttemptDotStyle}" />
                    <Ellipse x:Name="elpAttempt3" Style="{StaticResource AttemptDotStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Verification_ExpiresIn}"
                               Style="{StaticResource FieldLabelTextStyle}"
                               Margin="0,0,6,0" />
                    <TextBlock x:Name="lblExpiration"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush_Accent}" />
                </StackPanel>

                <Button x:Name="btnResendCode"
                        Content="{DynamicResource Verification_ResendButton}"
                        Style="{StaticResource ForgotPasswordLinkStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"
                        IsEnabled="False"
                        Click="BtnResendCode_Click" />

                <Button x:Name="btnVerifyCode"
                        Content="{DynamicResource Verification_VerifyButton}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,0,16"
                        Click="BtnVerifyCode_Click" />

                <Border BorderBrush="{StaticResource Brush_Border}"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0">
                    <Button x:Name="btnBack"
                            Content="{DynamicResource Verification_BackButton}"
                            Style="{StaticResource ForgotPasswordLinkStyle}"
                            HorizontalAlignment="Center"
                            Click="BtnBack_Click" />
                </Border>

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>