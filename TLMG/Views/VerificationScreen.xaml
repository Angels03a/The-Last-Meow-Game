<UserControl x:Class="TLMG.Views.VerificationScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}" Width="680">
            <StackPanel>
                <Border Style="{StaticResource VerificationHeaderIconBorderStyle}">
                    <TextBlock Text="✉" Style="{StaticResource HeaderEmojiStyle}" />
                </Border>

                <TextBlock Text="{DynamicResource Verification_Title}"
                           Style="{StaticResource CenteredTitleMediumTextStyle}" />

                <TextBlock Text="{DynamicResource Verification_Instructions}"
                           Style="{StaticResource CenteredSubtitleTextStyle}" />

                <StackPanel Style="{StaticResource VerificationDigitsContainerStyle}">
                    <TextBox x:Name="txtDigit1" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit2" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit3" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit4" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit5" Style="{StaticResource VerificationDigitStyle}" />
                    <TextBox x:Name="txtDigit6" Style="{StaticResource VerificationDigitStyle}" />
                </StackPanel>

                <StackPanel Style="{StaticResource AttemptDotsContainerStyle}">
                    <Ellipse x:Name="ellAttempt1" Style="{StaticResource AttemptDotStyle}" />
                    <Ellipse x:Name="ellAttempt2" Style="{StaticResource AttemptDotStyle}" />
                    <Ellipse x:Name="ellAttempt3" Style="{StaticResource AttemptDotStyle}" />
                </StackPanel>

                <StackPanel Style="{StaticResource ExpirationContainerStyle}">
                    <TextBlock Text="{DynamicResource Verification_ExpiresIn}"
                               Style="{StaticResource FieldLabelTextStyle}"
                               Margin="0,0,6,0" />
                    <TextBlock x:Name="lblExpiration"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush_Accent}" />
                </StackPanel>

                <Button x:Name="btnResendCode"
                        Content="{DynamicResource Verification_ResendButton}"
                        Style="{StaticResource VerificationResendButtonStyle}"
                        IsEnabled="False"
                        Click="BtnResendCode_Click" />

                <Button x:Name="btnVerifyCode"
                        Content="{DynamicResource Verification_VerifyButton}"
                        Style="{StaticResource VerificationPrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="BtnVerifyCode_Click" />

                <Border Style="{StaticResource VerificationBackContainerStyle}">
                    <Button x:Name="btnBack"
                            Content="{DynamicResource Verification_BackButton}"
                            Style="{StaticResource CenteredLinkButtonStyle}"
                            Click="BtnBack_Click" />
                </Border>

                <TextBlock x:Name="lblVerificationError"
                           Style="{StaticResource VerificationErrorTextStyle}" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>