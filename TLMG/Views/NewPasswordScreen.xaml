<UserControl x:Class="TLMG.Views.NewPasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="{StaticResource Brush_Border}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <Canvas Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="M 6,12 A 8,8 0 0 1 22,12"
                              Stroke="{StaticResource Brush_Accent}"
                              StrokeThickness="3" />
                        <Rectangle Canvas.Left="3"
                                   Canvas.Top="12"
                                   Width="22"
                                   Height="14"
                                   RadiusX="3"
                                   RadiusY="3"
                                   Fill="{StaticResource Brush_Accent}" />
                    </Canvas>
                </Border>

                <TextBlock Text="{DynamicResource NewPassword_Title}"
                           Style="{StaticResource TitleMediumTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource NewPassword_Instructions}"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,24" />

                <TextBlock Text="{DynamicResource NewPassword_Label}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />

                <StackPanel>
                    <PasswordBox x:Name="pwdNewPassword"
                                 Style="{StaticResource FieldStyle}"
                                 PasswordChanged="PwdNewPassword_PasswordChanged" />
                    <TextBlock x:Name="lblPasswordError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,2">
                    <Border x:Name="rectStrength1"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength2"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength3"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength4"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength5"
                            Style="{StaticResource StrengthIndicatorStyle}" />
                </StackPanel>

                <TextBlock x:Name="lblStrengthLabel"
                           Style="{StaticResource ErrorTextStyle}"
                           Margin="0,2,0,8" />

                <Border Style="{StaticResource HintPanelStyle}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource NewPassword_HintLength}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintUppercase}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintLowercase}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintNumber}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintSymbol}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource NewPassword_ConfirmLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />

                <StackPanel>
                    <PasswordBox x:Name="pwdConfirmPassword"
                                 Style="{StaticResource FieldStyle}" />
                    <TextBlock x:Name="lblMismatchError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <Button x:Name="btnSetPassword"
                        Content="{DynamicResource NewPassword_SetPasswordButton}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,20,0,12"
                        Click="BtnSetPassword_Click" />

                <Button x:Name="btnBackToForgotPassword"
                        Content="{DynamicResource NewPassword_BackButton}"
                        Style="{StaticResource ForgotPasswordLinkStyle}"
                        HorizontalAlignment="Center"
                        Click="BtnBackToForgotPassword_Click" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>