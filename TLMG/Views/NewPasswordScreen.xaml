<UserControl x:Class="TLMG.Views.NewPasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}" Width="680">
            <StackPanel>
                <StackPanel Style="{StaticResource StepTrackerContainerStyle}">
                    <Border Style="{StaticResource StepCircleActiveStyle}">
                        <TextBlock Text="1" Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepEmail}" Style="{StaticResource StepLabelActiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleActiveStyle}" Margin="12,0,0,0">
                        <TextBlock Text="2" Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepVerify}" Style="{StaticResource StepLabelActiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleActiveStyle}" Margin="12,0,0,0">
                        <TextBlock Text="3" Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepNewPassword}" Style="{StaticResource StepLabelActiveStyle}" Margin="8,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource HeaderIconBorderStyle}">
                    <TextBlock Text="🔒" Style="{StaticResource HeaderEmojiStyle}" />
                </Border>

                <TextBlock Text="{DynamicResource NewPassword_Title}"
                           Style="{StaticResource CenteredTitleMediumTextStyle}" />

                <TextBlock Text="{DynamicResource NewPassword_Instructions}"
                           Style="{StaticResource CenteredSubtitleTextStyle}" />

                <TextBlock Text="{DynamicResource NewPassword_Label}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />

                <StackPanel>
                    <PasswordBox x:Name="pwdNewPassword"
                                 Style="{StaticResource FieldStyle}"
                                 PasswordChanged="PwdNewPassword_PasswordChanged" />
                    <TextBlock x:Name="lblPasswordError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <UniformGrid Rows="1" Columns="5" Margin="0,8,0,2">
                    <Border x:Name="BorderStrength1" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="BorderStrength2" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="BorderStrength3" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="BorderStrength4" Style="{StaticResource StrengthBarStyle}" />
                    <Border x:Name="BorderStrength5" Style="{StaticResource StrengthBarStyle}" Margin="0" />
                </UniformGrid>

                <TextBlock x:Name="lblStrengthLabel"
                           Style="{StaticResource ErrorTextStyle}"
                           Margin="0,2,0,8" />

                <Border Style="{StaticResource HintPanelStyle}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource NewPassword_HintLength}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintUppercase}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintLowercase}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintNumber}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource NewPassword_HintSymbol}" Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource NewPassword_ConfirmLabel}"
                           Style="{StaticResource FieldLabelTextStyle}" />

                <StackPanel>
                    <PasswordBox x:Name="pwdConfirmPassword"
                                 Style="{StaticResource FieldStyle}" />
                    <TextBlock x:Name="lblMismatchError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <Button x:Name="btnSetPassword"
                        Content="{DynamicResource NewPassword_SetPasswordButton}"
                        Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                        Margin="0,20,0,12"
                        Click="BtnSetPassword_Click" />

                <Button x:Name="btnBackToForgotPassword"
                        Content="{DynamicResource NewPassword_BackButton}"
                        Style="{StaticResource CenteredLinkButtonStyle}"
                        Click="BtnBackToForgotPassword_Click" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>