<local:LocalizableScreen x:Class="TLMG.Views.ForgotPasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TLMG.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <local:LocalizableScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:LocalizableScreen.Resources>

    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}" Width="680">
            <StackPanel>
                <StackPanel Style="{StaticResource StepTrackerContainerStyle}">
                    <Border Style="{StaticResource StepCircleActiveStyle}">
                        <TextBlock Text="1" 
                                   Style="{StaticResource StepNumberActiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepEmail}" 
                               Style="{StaticResource StepLabelActiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleInactiveStyle}">
                        <TextBlock Text="2" 
                                   Style="{StaticResource StepNumberInactiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepVerify}" 
                               Style="{StaticResource StepLabelInactiveStyle}" />
                    <Border Style="{StaticResource StepSeparatorStyle}" />

                    <Border Style="{StaticResource StepCircleInactiveStyle}">
                        <TextBlock Text="3" 
                                   Style="{StaticResource StepNumberInactiveStyle}" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepNewPassword}" 
                               Style="{StaticResource StepLabelInactiveStyle}" Margin="8,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource HeaderIconBorderStyle}">
                    <TextBlock Text="🔒" Style="{StaticResource HeaderEmojiStyle}" />
                </Border>

                <TextBlock Text="{DynamicResource ForgotPassword_Title}" 
                           Style="{StaticResource CenteredTitleMediumTextStyle}" />

                <TextBlock Text="{DynamicResource ForgotPassword_Instructions}" 
                           Style="{StaticResource CenteredSubtitleTextStyle}" />

                <TextBlock Text="{DynamicResource ForgotPassword_EmailLabel}" 
                           Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,6" />

                <StackPanel Margin="0,0,0,16">
                    <TextBox x:Name="txtEmail" 
                             Style="{StaticResource FieldStyle}" 
                             LostFocus="TxtEmail_LostFocus" />
                    <TextBlock x:Name="lblEmailError" 
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <Button x:Name="btnSendCode" 
                        Content="{DynamicResource ForgotPassword_SendCodeButton}" 
                        Style="{StaticResource BottomActionPrimaryButtonStyle}" 
                        Click="BtnSendCode_Click" />

                <Button x:Name="btnBackToLogin" 
                        Content="{DynamicResource ForgotPassword_BackToLoginButton}" 
                        Style="{StaticResource CenteredLinkButtonStyle}" 
                        Click="BtnBackToLogin_Click" />

                <TextBlock x:Name="lblFormMessage" 
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</local:LocalizableScreen>