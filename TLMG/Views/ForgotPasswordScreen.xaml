<UserControl x:Class="TLMG.Views.ForgotPasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Background="#0D0D12">
        <Border Width="460"
                Background="#1A1A24"
                BorderBrush="#2E2E4A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="48,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="#8B5CF6">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepEmail}"
                               FontSize="11"
                               Foreground="#E8E6F0"
                               VerticalAlignment="Center"
                               Margin="6,0,10,0" />
                    <Border Width="30"
                            Height="1"
                            Background="#2E2E4A"
                            VerticalAlignment="Center" />
                    <Border Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="#2E2E4A"
                            Margin="10,0,0,0">
                        <TextBlock Text="2"
                                   Foreground="#8880A8"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepVerify}"
                               FontSize="11"
                               Foreground="#8880A8"
                               VerticalAlignment="Center"
                               Margin="6,0,10,0" />
                    <Border Width="30"
                            Height="1"
                            Background="#2E2E4A"
                            VerticalAlignment="Center" />
                    <Border Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="#2E2E4A"
                            Margin="10,0,0,0">
                        <TextBlock Text="3"
                                   Foreground="#8880A8"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource ForgotPassword_StepNewPassword}"
                               FontSize="11"
                               Foreground="#8880A8"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </StackPanel>

                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="#2E2E4A"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <Canvas Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="M 6,12 A 8,8 0 0 1 22,12"
                              Stroke="#8B5CF6"
                              StrokeThickness="3" />
                        <Rectangle Canvas.Left="3"
                                   Canvas.Top="12"
                                   Width="22"
                                   Height="14"
                                   RadiusX="3"
                                   RadiusY="3"
                                   Fill="#8B5CF6" />
                    </Canvas>
                </Border>

                <TextBlock Text="{DynamicResource ForgotPassword_Title}"
                           FontFamily="Georgia"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#E8E6F0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource ForgotPassword_Instructions}"
                           FontSize="13"
                           Foreground="#8880A8"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24" />

                <TextBlock Text="{DynamicResource ForgotPassword_EmailLabel}"
                           FontSize="12"
                           Foreground="#8880A8"
                           Margin="0,0,0,6" />

                <TextBox x:Name="txtEmail"
                         Height="36"
                         Padding="8,6"
                         Background="#0D0D12"
                         Foreground="#E8E6F0"
                         BorderBrush="#2E2E4A"
                         LostFocus="TxtEmail_LostFocus" />

                <TextBlock x:Name="lblEmailError"
                           FontSize="11"
                           Foreground="#EF4444"
                           Margin="0,4,0,0"
                           Visibility="Collapsed" />

                <Button x:Name="btnSendCode"
                        Content="{DynamicResource ForgotPassword_SendCodeButton}"
                        Height="42"
                        Background="#8B5CF6"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,20,0,12"
                        Click="BtnSendCode_Click" />

                <Button x:Name="btnBackToLogin"
                        Content="{DynamicResource ForgotPassword_BackToLoginButton}"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#8880A8"
                        FontSize="12"
                        Click="BtnBackToLogin_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>