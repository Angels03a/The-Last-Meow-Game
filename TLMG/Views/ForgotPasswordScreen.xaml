<UserControl x:Class="TLMG.Views.ForgotPasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Brush_Accent}">
                            <TextBlock Text="1" Foreground="{StaticResource Brush_White}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource ForgotPassword_StepEmail}" FontSize="11" Foreground="{StaticResource Brush_TextPrimary}" VerticalAlignment="Center" Margin="6,0,10,0" />
                        <Border Width="30" Height="1" Background="{StaticResource Brush_Border}" VerticalAlignment="Center" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Brush_Border}" Margin="10,0,0,0">
                            <TextBlock Text="2" Foreground="{StaticResource Brush_TextMuted}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource ForgotPassword_StepVerify}" FontSize="11" Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center" Margin="6,0,10,0" />
                        <Border Width="30" Height="1" Background="{StaticResource Brush_Border}" VerticalAlignment="Center" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Brush_Border}" Margin="10,0,0,0">
                            <TextBlock Text="3" Foreground="{StaticResource Brush_TextMuted}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource ForgotPassword_StepNewPassword}" FontSize="11" Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Viewbox>

                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Brush_Border}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 6,12 A 8,8 0 0 1 22,12" Stroke="{StaticResource Brush_Accent}" StrokeThickness="3" />
                        <Rectangle Canvas.Left="3" Canvas.Top="12" Width="22" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Brush_Accent}" />
                    </Canvas>
                </Border>

                <TextBlock Text="{DynamicResource ForgotPassword_Title}" Style="{StaticResource TitleMediumTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource ForgotPassword_Instructions}" Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                <TextBlock Text="{DynamicResource ForgotPassword_EmailLabel}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,6" />

                <StackPanel Margin="0,0,0,16">
                    <TextBox x:Name="txtEmail" Style="{StaticResource FieldStyle}" LostFocus="TxtEmail_LostFocus" />
                    <TextBlock x:Name="lblEmailError" Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <Button x:Name="btnSendCode" Content="{DynamicResource ForgotPassword_SendCodeButton}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,4,0,12" Click="BtnSendCode_Click" />

                <Button x:Name="btnBackToLogin" Content="{DynamicResource ForgotPassword_BackToLoginButton}" Style="{StaticResource ForgotPasswordLinkStyle}" HorizontalAlignment="Center" Click="BtnBackToLogin_Click" />
                
                <TextBlock x:Name="lblFormMessage" Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>