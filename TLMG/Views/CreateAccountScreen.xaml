<UserControl x:Class="TLMG.Views.CreateAccountScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource Brush_BackgroundDark}">
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="{StaticResource Brush_Border}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <Canvas Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Ellipse Canvas.Left="8"
                                 Canvas.Top="2"
                                 Width="12"
                                 Height="12"
                                 Fill="{StaticResource Brush_Accent}" />
                        <Path Data="M 4,26 A 10,10 0 0 1 24,26 Z"
                              Fill="{StaticResource Brush_Accent}" />
                    </Canvas>
                </Border>

                <TextBlock Text="{DynamicResource CreateAccount_Title}"
                           Style="{StaticResource TitleMediumTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource CreateAccount_Instructions}"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24" />

                <TextBlock Text="{DynamicResource CreateAccount_NicknameLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />

                <StackPanel Margin="0,0,0,16">
                    <TextBox x:Name="txtNickname"
                             Style="{StaticResource FieldStyle}" />
                    <TextBlock x:Name="lblNicknameError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <TextBlock Text="{DynamicResource CreateAccount_EmailLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />

                <StackPanel Margin="0,0,0,16">
                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource FieldStyle}" />
                    <TextBlock x:Name="lblEmailError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <TextBlock Text="{DynamicResource CreateAccount_PasswordLabel}"
                           Style="{StaticResource FieldLabelTextStyle}"
                           Margin="0,0,0,6" />

                <StackPanel>
                    <PasswordBox x:Name="pwdPassword"
                                 Style="{StaticResource FieldStyle}"
                                 PasswordChanged="PwdPassword_PasswordChanged" />
                    <TextBlock x:Name="lblPasswordError"
                               Style="{StaticResource ErrorTextStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,2">
                    <Border x:Name="rectStrength1"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength2"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength3"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength4"
                            Style="{StaticResource StrengthIndicatorStyle}"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength5"
                            Style="{StaticResource StrengthIndicatorStyle}" />
                </StackPanel>

                <TextBlock x:Name="lblStrengthLabel"
                           Style="{StaticResource ErrorTextStyle}"
                           Margin="0,2,0,8" />

                <Border Style="{StaticResource HintPanelStyle}"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CreateAccount_HintLength}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintUppercase}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintLowercase}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintNumber}"
                                   Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintSymbol}"
                                   Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </Border>

                <Button x:Name="btnVerifyEmail"
                        Content="{DynamicResource CreateAccount_VerifyEmailButton}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,12"
                        Click="BtnVerifyEmail_Click" />

                <Button x:Name="btnBack"
                        Content="{DynamicResource CreateAccount_BackButton}"
                        Style="{StaticResource ForgotPasswordLinkStyle}"
                        HorizontalAlignment="Center"
                        Click="BtnBack_Click" />

                <TextBlock x:Name="lblFormMessage"
                           Style="{StaticResource FormMessageTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>