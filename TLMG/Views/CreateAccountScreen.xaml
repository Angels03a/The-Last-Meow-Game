<UserControl x:Class="TLMG.Views.CreateAccountScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TLMG;component/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource Brush_BackgroundDark}">
            <Ellipse Style="{StaticResource HeroBackgroundGlowStyle}" />

            <StackPanel Style="{StaticResource HeroContentPanelStyle}">
                <TextBlock Text="🚀" Style="{StaticResource HeroMainEmojiStyle}" />

                <TextBlock Text="{DynamicResource CreateAccount_HeaderTitle}" Style="{StaticResource HeroTitleTextStyle}" />
                <TextBlock Text="{DynamicResource CreateAccount_HeaderSubtitle}" Style="{StaticResource HeroSubtitleSpacedTextStyle}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🐈‍" Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Cat_Egyptian}" Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🧟" Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Cat_Zombie}" Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="💀" Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Cat_Skull}" Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource HeroEmojiContainerStyle}">
                        <TextBlock Text="🚀" Style="{StaticResource HeroEmojiStyle}" />
                        <TextBlock Text="{DynamicResource Cat_Astronaut}" Style="{StaticResource MainMenuAvatarLabelStyle}" />
                    </StackPanel>
                </StackPanel>   
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource SidePanelBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Style="{StaticResource SidePanelContentStyle}">

                    <Button x:Name="btnBack"
                            Content="{DynamicResource CreateAccount_BackToLogin}"
                            Style="{StaticResource TopLeftLinkButtonStyle}"
                            Click="BtnBack_Click" />

                    <TextBlock Text="{DynamicResource CreateAccount_Title}"
                               Style="{StaticResource FormTitleTextStyle}" />

                    <TextBlock Text="{DynamicResource CreateAccount_NicknameLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="txtNickname"
                             Style="{StaticResource FieldStyle}" />
                    <TextBlock Text="{DynamicResource CreateAccount_NicknameHint}" 
                               Style="{StaticResource FieldHintTextStyle}" />
                    <TextBlock x:Name="lblNicknameError"
                               Style="{StaticResource ErrorTextStyle}" />

                    <TextBlock Text="{DynamicResource CreateAccount_EmailLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource FieldStyle}" />
                    <TextBlock x:Name="lblEmailError"
                               Style="{StaticResource ErrorTextStyle}" />

                    <TextBlock Text="{DynamicResource CreateAccount_PasswordLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <PasswordBox x:Name="pwdPassword"
                                 Style="{StaticResource FieldStyle}"
                                 PasswordChanged="PwdPassword_PasswordChanged" />
                    <TextBlock x:Name="lblPasswordError"
                               Style="{StaticResource ErrorTextStyle}" />

                    <Border Style="{StaticResource SpacedHintPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CreateAccount_HintLength}" Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintUppercase}" Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintLowercase}" Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintNumber}" Style="{StaticResource StatusTextStyle}" />
                            <TextBlock Text="{DynamicResource CreateAccount_HintSymbol}" Style="{StaticResource StatusTextStyle}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource CreateAccount_ConfirmPasswordLabel}"
                               Style="{StaticResource FieldLabelTextStyle}" />
                    <PasswordBox x:Name="pwdConfirmPassword"
                                 Style="{StaticResource FieldStyle}" />
                    <TextBlock x:Name="lblConfirmPasswordError"
                               Style="{StaticResource ErrorTextStyle}" />

                    <CheckBox x:Name="chkTerms" Style="{StaticResource TermsCheckBoxStyle}">
                        <TextBlock Text="{DynamicResource CreateAccount_TermsText}" 
                                   Style="{StaticResource TermsTextStyle}" />
                    </CheckBox>

                    <Button x:Name="btnCreateAccount"
                            Content="{DynamicResource CreateAccount_CreateAccountButton}"
                            Style="{StaticResource AuthenticationPrimaryButtonStyle}"
                            Click="BtnCreateAccount_Click" />

                    <TextBlock x:Name="lblFormMessage"
                               Style="{StaticResource FormMessageTextStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>