<UserControl x:Class="TLMG.Views.CreateAccountScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="900">
    <Grid Background="#0D0D12">
        <Border Width="460"
                Background="#1A1A24"
                BorderBrush="#2E2E4A"
                BorderThickness="1"
                CornerRadius="16"
                Padding="48,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        Background="#2E2E4A"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <Canvas Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Ellipse Canvas.Left="8"
                                 Canvas.Top="2"
                                 Width="12"
                                 Height="12"
                                 Fill="#8B5CF6" />
                        <Path Data="M 4,26 A 10,10 0 0 1 24,26 Z"
                              Fill="#8B5CF6" />
                    </Canvas>
                </Border>

                <TextBlock Text="{DynamicResource CreateAccount_Title}"
                           FontFamily="Georgia"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#E8E6F0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource CreateAccount_Instructions}"
                           FontSize="13"
                           Foreground="#8880A8"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24" />

                <TextBlock Text="{DynamicResource CreateAccount_NicknameLabel}"
                           FontSize="12"
                           Foreground="#8880A8"
                           Margin="0,0,0,6" />

                <TextBox x:Name="txtNickname"
                         Height="36"
                         Padding="8,6"
                         Background="#0D0D12"
                         Foreground="#E8E6F0"
                         BorderBrush="#2E2E4A"
                         Margin="0,0,0,16" />

                <TextBlock Text="{DynamicResource CreateAccount_EmailLabel}"
                           FontSize="12"
                           Foreground="#8880A8"
                           Margin="0,0,0,6" />

                <TextBox x:Name="txtEmail"
                         Height="36"
                         Padding="8,6"
                         Background="#0D0D12"
                         Foreground="#E8E6F0"
                         BorderBrush="#2E2E4A"
                         Margin="0,0,0,16" />

                <TextBlock Text="{DynamicResource CreateAccount_PasswordLabel}"
                           FontSize="12"
                           Foreground="#8880A8"
                           Margin="0,0,0,6" />

                <PasswordBox x:Name="pwdPassword"
                             Height="36"
                             Padding="8,6"
                             Background="#0D0D12"
                             Foreground="#E8E6F0"
                             BorderBrush="#2E2E4A"
                             PasswordChanged="PwdPassword_PasswordChanged" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,2">
                    <Border x:Name="rectStrength1"
                            Width="60"
                            Height="4"
                            Background="#2E2E4A"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength2"
                            Width="60"
                            Height="4"
                            Background="#2E2E4A"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength3"
                            Width="60"
                            Height="4"
                            Background="#2E2E4A"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength4"
                            Width="60"
                            Height="4"
                            Background="#2E2E4A"
                            Margin="0,0,3,0" />
                    <Border x:Name="rectStrength5"
                            Width="60"
                            Height="4"
                            Background="#2E2E4A" />
                </StackPanel>

                <TextBlock x:Name="lblStrengthLabel"
                           FontSize="11"
                           Margin="0,2,0,8"
                           Visibility="Collapsed" />

                <Border Background="#0D0D18"
                        BorderBrush="#2E2E4A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CreateAccount_HintLength}"
                                   FontSize="11"
                                   Foreground="#5A5670" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintUppercase}"
                                   FontSize="11"
                                   Foreground="#5A5670" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintLowercase}"
                                   FontSize="11"
                                   Foreground="#5A5670" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintNumber}"
                                   FontSize="11"
                                   Foreground="#5A5670" />
                        <TextBlock Text="{DynamicResource CreateAccount_HintSymbol}"
                                   FontSize="11"
                                   Foreground="#5A5670" />
                    </StackPanel>
                </Border>

                <Button x:Name="btnVerifyEmail"
                        Content="{DynamicResource CreateAccount_VerifyEmailButton}"
                        Height="42"
                        Background="#8B5CF6"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,0,12"
                        Click="BtnVerifyEmail_Click" />

                <Button x:Name="btnBack"
                        Content="{DynamicResource CreateAccount_BackButton}"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#8880A8"
                        FontSize="12"
                        Click="BtnBack_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>